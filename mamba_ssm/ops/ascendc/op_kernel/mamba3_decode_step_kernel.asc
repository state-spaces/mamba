    __aicore__ inline void Process()
    {
        const int64_t grid = t_->grid;
        const int64_t blockNum = t_->blockNum;
        const int64_t dTiles = t_->dTiles;
        const int64_t heads = t_->heads;
        storePending_ = false;
        for (int64_t idx = GetBlockIdx(); idx < grid; idx += blockNum) {
            const int64_t td = idx % dTiles;
            const int64_t rest = idx / dTiles;
            const int64_t hh = rest % heads;
            const int64_t bb = rest / heads;
            ProcessTile(bb, hh, td * t_->tileD);
        }
        // 末尾最后一次落盘的收口（正常路径下由下一 job 的 P0 收口处承接）
        if (storePending_) {
            SyncMte3ToVec();
            storePending_ = false;
        }
    }

