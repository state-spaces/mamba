    // 下一次 MTE2 覆写 stage 前，确保此前所有 Vector 读写已完成（chunk 间复用缓冲）
    __aicore__ inline void SyncVecToMte2()
    {
        SetFlag<HardEvent::V_MTE2>(static_cast<event_t>(EVENT_ID4));
        WaitFlag<HardEvent::V_MTE2>(static_cast<event_t>(EVENT_ID4));
    }

    // ------------------------------------------------------------------ 搬运
    __aicore__ inline void LoadRows(LocalTensor<uint8_t> stage, GM_ADDR base, int64_t byteOff, int32_t rowCount,
                                    int32_t cols, int64_t rowStrideElems, int32_t dt)
    {
        const uint32_t esz = ElemSize(dt);
        const uint32_t gap = static_cast<uint32_t>((rowStrideElems - static_cast<int64_t>(cols)) * esz);
        DataCopyExtParams cp{static_cast<uint16_t>(rowCount), static_cast<uint32_t>(cols) * esz, gap, 0u, 0u};
        if (dt == DT_FP32) {
            DataCopyPadExtParams<float> pp{false, 0, 0, 0};
            GlobalTensor<float> g;
            g.SetGlobalBuffer((__gm__ float *)(base + byteOff));
            DataCopyPad(stage.ReinterpretCast<float>(), g, cp, pp);
        } else if (dt == DT_FP16) {
            DataCopyPadExtParams<half> pp{false, 0, 0, 0};
            GlobalTensor<half> g;
            g.SetGlobalBuffer((__gm__ half *)(base + byteOff));
            DataCopyPad(stage.ReinterpretCast<half>(), g, cp, pp);
        } else {
            DataCopyPadExtParams<bfloat16_t> pp{false, 0, 0, 0};
            GlobalTensor<bfloat16_t> g;
            g.SetGlobalBuffer((__gm__ bfloat16_t *)(base + byteOff));
            DataCopyPad(stage.ReinterpretCast<bfloat16_t>(), g, cp, pp);
        }
    }

    __aicore__ inline void StoreRows(GM_ADDR base, int64_t byteOff, int32_t rowCount, int32_t cols,
                                     int64_t rowStrideElems, int32_t dt, LocalTensor<uint8_t> stage)
    {
        const uint32_t esz = ElemSize(dt);
        // UB->GM：GM 侧行间隔走 dstStride（字节），UB 侧行紧凑
        const uint32_t gap = static_cast<uint32_t>((rowStrideElems - static_cast<int64_t>(cols)) * esz);
        DataCopyExtParams cp{static_cast<uint16_t>(rowCount), static_cast<uint32_t>(cols) * esz, 0u, gap, 0u};
        if (dt == DT_FP32) {
            GlobalTensor<float> g;
            g.SetGlobalBuffer((__gm__ float *)(base + byteOff));
            DataCopyPad(g, stage.ReinterpretCast<float>(), cp);
        } else if (dt == DT_FP16) {
            GlobalTensor<half> g;
            g.SetGlobalBuffer((__gm__ half *)(base + byteOff));
            DataCopyPad(g, stage.ReinterpretCast<half>(), cp);
        } else {
            GlobalTensor<bfloat16_t> g;
            g.SetGlobalBuffer((__gm__ bfloat16_t *)(base + byteOff));
            DataCopyPad(g, stage.ReinterpretCast<bfloat16_t>(), cp);
        }
    }

    __aicore__ inline void StageToFp32(LocalTensor<float> dst, LocalTensor<uint8_t> stage, int32_t count, int32_t dt)
    {
        if (dt == DT_FP32) {
            Adds(dst, stage.ReinterpretCast<float>(), 0.0f, count);
        } else if (dt == DT_FP16) {
            Cast(dst, stage.ReinterpretCast<half>(), RoundMode::CAST_NONE, static_cast<uint32_t>(count));
        } else {
            Cast(dst, stage.ReinterpretCast<bfloat16_t>(), RoundMode::CAST_NONE, static_cast<uint32_t>(count));
        }
    }

    __aicore__ inline void Fp32ToStage(LocalTensor<uint8_t> stage, LocalTensor<float> src, int32_t count, int32_t dt)
    {
        if (dt == DT_FP32) {
            Adds(stage.ReinterpretCast<float>(), src, 0.0f, count);
        } else if (dt == DT_FP16) {
            Cast(stage.ReinterpretCast<half>(), src, RoundMode::CAST_RINT, static_cast<uint32_t>(count));
        } else {
            Cast(stage.ReinterpretCast<bfloat16_t>(), src, RoundMode::CAST_RINT, static_cast<uint32_t>(count));
        }
    }

    // PLUT-136 C1：A/dt/trap/D 四个标量按 32B 槽位排布，fp32 输入时一次指令转完（原来 4 次一元指令）
    __aicore__ inline void StageToFp32Slots(LocalTensor<float> dst, LocalTensor<uint8_t> stage, int32_t dt)
    {
        if (dt == DT_FP32) {
            // mask=1 × repeat=4，dst/src 都以 1 个 block(32B) 为 repeat 步长 ⇒ 4 个槽位一次覆盖
            Adds(dst, stage.ReinterpretCast<float>(), 0.0f, 1, 4, UnaryRepeatParams(1, 1, 1, 1));
            return;
        }
        StageToFp32(dst, stage, 1, dt);
        StageToFp32(dst[8], stage[32], 1, dt);
        StageToFp32(dst[16], stage[64], 1, dt);
        StageToFp32(dst[24], stage[96], 1, dt);
    }

    // PLUT-136 C2：fp32 输出时 stage 与源缓冲是同一份字节，省掉一次整平面「+0 拷贝」；
    // 16 位 dtype 才真正需要收窄进 stage（CAST_RINT 语义不变）。
    __aicore__ inline void NarrowStageTo(LocalTensor<uint8_t> stage, LocalTensor<float> src, int32_t count, int32_t dt)
    {
        if (dt != DT_FP32) {
            Fp32ToStage(stage, src, count, dt);
        }
    }

    // 转 fp32 并就地乘标量：fp32 输入直接 Muls（省去一次「零加拷贝」平面遍历）
    __aicore__ inline void StageScaleToFp32(LocalTensor<float> dst, LocalTensor<uint8_t> stage, int32_t count,
                                            int32_t dt, float scale)
    {
        if (dt == DT_FP32) {
            Muls(dst, stage.ReinterpretCast<float>(), scale, count);
            return;
        }
        StageToFp32(dst, stage, count, dt);
        Muls(dst, dst, scale, count);
    }

    // ------------------------------------------------------------------ 主流程
    __aicore__ inline void ProcessTile(int64_t bb, int64_t hh, int64_t d0)
    {
        const int64_t n = t_->dState;
        const int64_t rank = t_->rank;
        const int64_t tileD = t_->tileD;
        const int64_t rows = t_->chunkRows;
        const int64_t rb = t_->rankBlock;
        const int32_t dtState = static_cast<int32_t>(t_->dtypeState);
        const int32_t dtBC = static_cast<int32_t>(t_->dtypeBC);
        const int32_t dtX = static_cast<int32_t>(t_->dtypeX);
        const int32_t dtProj = static_cast<int32_t>(t_->dtypeProj);
        const int32_t dtScalar = static_cast<int32_t>(t_->dtypeScalar);
        const int64_t eszState = static_cast<int64_t>(ElemSize(dtState));
        const int64_t eszBC = static_cast<int64_t>(ElemSize(dtBC));
        const int64_t eszX = static_cast<int64_t>(ElemSize(dtX));
        const int64_t eszProj = static_cast<int64_t>(ElemSize(dtProj));
        const int64_t eszScalar = static_cast<int64_t>(ElemSize(dtScalar));
        const int32_t rowsI = static_cast<int32_t>(rows);
        const int32_t nI = static_cast<int32_t>(n);
        const int32_t planeI = static_cast<int32_t>(rows * n);
        const uint8_t slotRep = static_cast<uint8_t>(rows / SLOT);
        const int32_t nBlocks = static_cast<int32_t>(n / SLOT);

        LocalTensor<uint8_t> raw = bufRaw_.Get<uint8_t>();
        LocalTensor<uint8_t> wb = bufWb_.Get<uint8_t>();
        LocalTensor<uint8_t> outRaw = bufOutRaw_.Get<uint8_t>();
        LocalTensor<float> outF = bufOutF_.Get<float>();
        LocalTensor<uint8_t> bcStage = bufBcStage_.Get<uint8_t>();
        LocalTensor<uint8_t> projStage = bufProjStage_.Get<uint8_t>();
        LocalTensor<uint8_t> vecStage = bufVecStage_.Get<uint8_t>();
        LocalTensor<uint8_t> scalarStage = bufScalarStage_.Get<uint8_t>();

        LocalTensor<float> sF = bufS_.Get<float>();
        LocalTensor<float> prod = bufProd_.Get<float>();
        LocalTensor<float> bcf = bufBc_.Get<float>();
        LocalTensor<float> projf = bufProj_.Get<float>();
        LocalTensor<float> xF = bufX_.Get<float>();
        LocalTensor<float> xsF = bufXs_.Get<float>();
        LocalTensor<float> zF = bufZ_.Get<float>();
        LocalTensor<float> uF = bufU_.Get<float>();
        LocalTensor<float> vF = bufV_.Get<float>();
        LocalTensor<float> dxF = bufDx_.Get<float>();
        LocalTensor<float> wRow = bufW_.Get<float>();
        LocalTensor<float> dotV = bufDot_.Get<float>();
        LocalTensor<float> tmpV = bufTmp_.Get<float>();
        LocalTensor<float> gateV = bufGate_.Get<float>();
        LocalTensor<float> accV = bufAcc_.Get<float>();
        LocalTensor<float> w8 = bufW8_.Get<float>();
        LocalTensor<float> scalarF = bufScalar_.Get<float>();
        LocalTensor<float> expTmp = bufExpTmp_.Get<float>();

        const int64_t rbNStride = AlignBytes(rb * n * eszBC);  // 原始 dtype 的 stage 偏移
        const int64_t rbRowStride = AlignBytes(rb * rows * eszProj);
        const int64_t vecRowStride = AlignBytes(rows * eszX);
        const int64_t rbNF = AlignBytes(rb * n * 4);  // fp32 缓冲偏移
        const int64_t rbRowF = AlignBytes(rb * rows * 4);

        LocalTensor<float> bF = bcf;
        LocalTensor<float> bsF = bcf[rbNF / 4];
        LocalTensor<float> cF = bcf[2 * (rbNF / 4)];
        LocalTensor<float> xpF = projf;
        LocalTensor<float> opF = projf[rbRowF / 4];
        LocalTensor<float> zpF = projf[2 * (rbRowF / 4)];

        // ---- 标量: alpha / beta / gamma ----
        // PLUT-136 C1（标量链向量化）：a*dt 改在 Vector 侧一次算完，整条链只留一次 V→S 同步；
        // 原实现是「cast → V_S → GetValue a,dt → Duplicate(a*dt) → Exp → V_S → GetValue alpha」，
        // 每个 job 两次 V_S 往返，且第二次往返把 Exp 的延迟整段暴露在标量链上。
        // PLUT-215 R4-P1：tile 入口的 V→MTE2 等待下移到 chunk 循环内（见下），
        // 让这 4 笔标量 MTE2 与 a*dt/Exp 的标量链与本 job 之前的向量尾巴重叠。
        // 安全性：这 4 笔只写 scalarStage（128 B），上一个 job 对它的最后一次向量读已被
        // 它自己的 SyncVecToScalar（V→S）收口，且 StageToFp32Slots 之后的向量指令在程序序上
        // 排在上一个 job 的向量指令之后；真正需要等待的 raw/bc/proj/vec stage 覆写发生在
        // chunk 循环里，那里有等价的 SyncVecToMte2。
        LoadRows(scalarStage, a_, (bb * t_->sAB + hh * t_->sAH) * eszScalar, 1, 1, 1, dtScalar);
        LoadRows(scalarStage[32], dt_, (bb * t_->sDtB + hh * t_->sDtH) * eszScalar, 1, 1, 1, dtScalar);
        LoadRows(scalarStage[64], trap_, (bb * t_->sTrapB + hh * t_->sTrapH) * eszScalar, 1, 1, 1, dtScalar);
        LoadRows(scalarStage[96], d_, hh * t_->sDh * eszScalar, 1, 1, 1, dtScalar);
        SyncMte2ToVec();
        StageToFp32Slots(scalarF, scalarStage, dtScalar);
        Mul(expTmp, scalarF, scalarF[8], SLOT);  // expTmp = a*dt（fp32 乘，与原标量乘同一舍入）
        Exp(expTmp, expTmp, SLOT);
        SyncVecToScalar();
        const float alpha = expTmp.GetValue(0);
        const float dtVal = scalarF.GetValue(8);
        const float trapVal = scalarF.GetValue(16);
        const float dVal = scalarF.GetValue(24);
        const float gamma = trapVal * dtVal;
        const float beta = (1.0f - trapVal) * dtVal * alpha;

        const int64_t chunks = tileD / rows;
        for (int64_t c = 0; c < chunks; ++c) {
            const int64_t d0c = d0 + c * rows;

            // 上一 chunk / 上一 job 的 Vector 读写必须完成后，才能用 MTE2 覆写同一组 stage 缓冲。
            // R4-P1：改为每个 chunk 都无条件等一次（count 不变，tile 入口那次已下移到这里）。
            SyncVecToMte2();

            // ---- 搬运: state chunk / B / Bstate / C / xproj / outproj / zproj / x / Xstate / z ----
            const int32_t rankCur = static_cast<int32_t>(rank < rb ? rank : rb);
            LoadRows(raw, state_, (bb * t_->sStateB + hh * t_->sStateH + d0c * t_->sStateD) * eszState, rowsI, nI,
                     t_->sStateD, dtState);
            LoadRows(bcStage, b_, (bb * t_->sBB + hh * t_->sBH) * eszBC, rankCur, nI, t_->sBR, dtBC);
            LoadRows(bcStage[rbNStride], bstate_, (bb * t_->sBstateB + hh * t_->sBstateH) * eszBC, rankCur, nI,
                     t_->sBstateR, dtBC);
            LoadRows(bcStage[2 * rbNStride], c_, (bb * t_->sCB + hh * t_->sCH) * eszBC, rankCur, nI, t_->sCR, dtBC);
            LoadRows(projStage, xproj_, (hh * t_->sXprojH + d0c) * eszProj, rankCur, rowsI, t_->sXprojR, dtProj);
            if (t_->hasOutproj != 0) {
                LoadRows(projStage[rbRowStride], outproj_, (hh * t_->sOutprojH + d0c) * eszProj, rankCur, rowsI,
                         t_->sOutprojR, dtProj);
            }
            if (t_->hasZ != 0) {
                LoadRows(projStage[2 * rbRowStride], zproj_, (hh * t_->sZprojH + d0c) * eszProj, rankCur, rowsI,
                         t_->sZprojR, dtProj);
            }
            LoadRows(vecStage, x_, (bb * t_->sXB + hh * t_->sXH + d0c) * eszX, 1, rowsI, rowsI, dtX);
            LoadRows(vecStage[vecRowStride], xstate_, (bb * t_->sXstateB + hh * t_->sXstateH + d0c) * eszX, 1,
                     rowsI, rowsI, dtX);
            if (t_->hasZ != 0) {
                LoadRows(vecStage[2 * vecRowStride], z_, (bb * t_->sZB + hh * t_->sZH + d0c) * eszX, 1, rowsI,
                         rowsI, dtX);
            }
            SyncMte2ToVec();

            // ---- 转换 / 标量缩放 ----
            StageToFp32(xF, vecStage, rowsI, dtX);
            StageToFp32(xsF, vecStage[vecRowStride], rowsI, dtX);
            if (t_->hasZ != 0) {
                StageToFp32(zF, vecStage[2 * vecRowStride], rowsI, dtX);
            }
            Muls(uF, xF, gamma, rowsI);
            Muls(vF, xsF, beta, rowsI);
            Muls(dxF, xF, dVal, rowsI);

            // PLUT-215 R4-P0：上一次 state_out 落盘的 MTE3 到这里才收口。
            // 原实现把 SyncMte3ToVec 紧贴在 StoreRows 之后（job 尾部原地等 32 KiB 落盘），
            // 现在推迟到「下一次写 sF/wb 之前」——中间隔着本 job 的标量链、平面装入、slot 转换，
            // 落盘可与这些工作重叠。只移动「何时等」，算式与访存形态逐字不变。
            // 之所以放在这里：sF（fp32）与 wb（16 位）就是落盘的源缓冲，此前没有任何写入。
            if (storePending_) {
                SyncMte3ToVec();
                storePending_ = false;
            }

            StageScaleToFp32(sF, raw, planeI, dtState, alpha);
            // ---- state_out 累加: sF += sum_r w1[r]*B[r] + w2[r]*Bs[r] ----
            for (int64_t r0 = 0; r0 < rank; r0 += rb) {
                const int32_t rbCur = static_cast<int32_t>((rank - r0 < rb) ? (rank - r0) : rb);
                if (r0 != 0) {
                    SyncVecToMte2();  // 上一 rank-block 的 Vector 读取完成后才能覆写 bcStage / projStage
                    LoadRows(bcStage, b_, (bb * t_->sBB + r0 * t_->sBR + hh * t_->sBH) * eszBC, rbCur, nI, t_->sBR,
                             dtBC);
                    LoadRows(bcStage[rbNStride], bstate_,
                             (bb * t_->sBstateB + r0 * t_->sBstateR + hh * t_->sBstateH) * eszBC, rbCur, nI,
                             t_->sBstateR, dtBC);
                    LoadRows(bcStage[2 * rbNStride], c_,
                             (bb * t_->sCB + r0 * t_->sCR + hh * t_->sCH) * eszBC, rbCur, nI, t_->sCR, dtBC);
                    LoadRows(projStage, xproj_, (r0 * t_->sXprojR + hh * t_->sXprojH + d0c) * eszProj, rbCur, rowsI,
                             t_->sXprojR, dtProj);
                    if (t_->hasOutproj != 0) {
                        LoadRows(projStage[rbRowStride], outproj_,
                                 (r0 * t_->sOutprojR + hh * t_->sOutprojH + d0c) * eszProj, rbCur, rowsI,
                                 t_->sOutprojR, dtProj);
                    }
                    if (t_->hasZ != 0) {
                        LoadRows(projStage[2 * rbRowStride], zproj_,
                                 (r0 * t_->sZprojR + hh * t_->sZprojH + d0c) * eszProj, rbCur, rowsI,
                                 t_->sZprojR, dtProj);
                    }
                    SyncMte2ToVec();
                }
                StageToFp32(bF, bcStage, rbCur * nI, dtBC);
                StageToFp32(bsF, bcStage[rbNStride], rbCur * nI, dtBC);
                StageToFp32(cF, bcStage[2 * rbNStride], rbCur * nI, dtBC);
                StageToFp32(xpF, projStage, rbCur * rowsI, dtProj);
                if (t_->hasOutproj != 0) {
                    StageToFp32(opF, projStage[rbRowStride], rbCur * rowsI, dtProj);
                }
                if (t_->hasZ != 0) {
                    StageToFp32(zpF, projStage[2 * rbRowStride], rbCur * rowsI, dtProj);
                }
                for (int32_t i = 0; i < rbCur; ++i) {
                    Mul(wRow, uF, xpF[i * rowsI], rowsI);  // w1 = u * xproj[r]
                    Brcb(w8, wRow, slotRep, BrcbRepeatParams(1, SLOT));
                    AccumRank(sF, bF[i * nI], w8, prod, rowsI, nI);
                    Mul(wRow, vF, xpF[i * rowsI], rowsI);  // w2 = v * xproj[r]
                    Brcb(w8, wRow, slotRep, BrcbRepeatParams(1, SLOT));
                    AccumRank(sF, bsF[i * nI], w8, prod, rowsI, nI);
                }
            }

            // ---- out ----
            if (t_->hasOutproj != 0) {
                Duplicate(accV, 0.0f, rowsI);
            }
            for (int64_t r0 = 0; r0 < rank; r0 += rb) {
                const int32_t rbCur = static_cast<int32_t>((rank - r0 < rb) ? (rank - r0) : rb);
                for (int32_t i = 0; i < rbCur; ++i) {
                    MulCBcast(prod, sF, cF[i * nI], rowsI, nI);
                    // R5-C1a：fp32 输出走精确树形（p0022 那条刀锋 case 逐字不动），16 位输出走宽归约
                    RowSumDot(dotV, prod, rowsI, nI, nBlocks, dtX != DT_FP32);
                    Mul(tmpV, dxF, xpF[i * rowsI], rowsI);
                    Add(dotV, dotV, tmpV, rowsI);
                    if (t_->hasOutproj != 0) {
                        if (t_->hasZ != 0) {
                            Mul(gateV, zF, zpF[i * rowsI], rowsI);
                            Sigmoid(tmpV, gateV, static_cast<uint32_t>(rowsI));
                            Mul(gateV, gateV, tmpV, rowsI);
                            Mul(dotV, dotV, gateV, rowsI);
                        }
                        MulAddDst(accV, dotV, opF[i * rowsI], rowsI);
                    } else {
                        // 先攒进 outF，等全部 rank 算完后一次写回（单次 MTE3 + 单次 barrier）
                        Muls(outF[i * rowsI], dotV, 1.0f, rowsI);
                    }
                }
            }

            // fp32 输出：stage 直接指向已算好的 fp32 缓冲（省一次整平面拷贝）；16 位：收窄进独立 stage
            LocalTensor<uint8_t> outStage = outRaw;
            if (t_->hasOutproj != 0) {
                if (dtX == DT_FP32) {
                    outStage = accV.ReinterpretCast<uint8_t>();
                }
                NarrowStageTo(outRaw, accV, rowsI, dtX);
                SyncVecToMte3();
                const int64_t outByte = (bb * t_->sOutB + hh * t_->sOutH + d0c) * eszX;
                StoreRows(out_, outByte, 1, rowsI, rowsI, dtX, outStage);
            } else {
                if (dtX == DT_FP32) {
                    outStage = outF.ReinterpretCast<uint8_t>();
                }
                NarrowStageTo(outRaw, outF, static_cast<int32_t>(rank) * rowsI, dtX);
                SyncVecToMte3();
                const int64_t outByte = (bb * t_->sOutB + hh * t_->sOutH + d0c) * eszX;
                StoreRows(out_, outByte, static_cast<int32_t>(rank), rowsI, t_->sOutR, dtX, outStage);
            }

            // ---- state_out 写回（独立 wb stage，不与点积暂存 prod 复用） ----
            LocalTensor<uint8_t> wbStage = wb;
            if (dtState == DT_FP32) {
                wbStage = sF.ReinterpretCast<uint8_t>();
            }
            NarrowStageTo(wb, sF, planeI, dtState);
            // PLUT-215 R4-P2：fp32 时 wbStage 就是 sF，而 sF 的全部写入都在上面那次
            // SyncVecToMte3（out 落盘前）之前，因此这里的 V→MTE3 是重复的 flag 往返，省掉；
            // 16 位时 NarrowStageTo 刚写过 wb，必须保留。
            if (dtState != DT_FP32) {
                SyncVecToMte3();
            }
            const int64_t stateOutByte =
                (bb * t_->sStateOutB + hh * t_->sStateOutH + d0c * t_->sStateOutD) * eszState;
            StoreRows(stateOut_, stateOutByte, rowsI, nI, t_->sStateOutD, dtState, wbStage);
            // PLUT-215 R4-P0：这里不再原地等落盘，改为打标记，由下一次写 sF/wb 之前收口
            // （见 chunk 循环内 StageScaleToFp32 之前的 storePending_ 检查）。
            storePending_ = true;
            // 本 chunk 的全部 stage 缓冲（raw/bc/proj/vec/prod/outRaw）在下一 chunk 会被覆盖，
            // 这里用整流水栅栏收口，避免 MTE2/MTE3/V 之间的残留依赖导致偶发脏读。
            // 单 chunk（chunksPerTile == 1）时不存在「同一组 stage 被下一 chunk 覆盖」，
            // 且上面的 V→MTE3 往返已把 V/MTE3 收口，故只在多 chunk 时保留该栅栏。
            if (c + 1 < chunks) {
                PipeBarrier<PIPE_ALL>();
            }
        }
    }

    // ------------------------------------------------------------------ 小工具
    // sF[rows,n] += bVec[n] * w8[rows,8]；n>=64 时先把 w8 二次广播成 w64（暂存 wScratch）
    __aicore__ inline void AccumRank(LocalTensor<float> sF, LocalTensor<float> bVec, LocalTensor<float> w8,
                                     LocalTensor<float> wScratch, int32_t rows, int32_t n)
    {
        const uint8_t dstRep = static_cast<uint8_t>(n / SLOT);
        if (n >= REP_ELEMS) {
            Brcb(wScratch, w8, static_cast<uint8_t>(rows), BrcbRepeatParams(1, SLOT));  // w64
            for (int32_t off = 0; off < n; off += REP_ELEMS) {
                const int32_t left = n - off;
                const uint64_t mask = static_cast<uint64_t>(left < REP_ELEMS ? left : REP_ELEMS);
                BinaryRepeatParams rp(1, 1, 1, dstRep, 0, static_cast<uint8_t>(SLOT));
                MulAddDst(sF[off], bVec[off], wScratch, mask, static_cast<uint8_t>(rows), rp);
            }
        } else {
            for (int32_t off = 0; off < n; off += SLOT) {
                BinaryRepeatParams rp(1, 1, 1, dstRep, 0, 1);
                MulAddDst(sF[off], bVec[off], w8, static_cast<uint64_t>(SLOT), static_cast<uint8_t>(rows), rp);
            }
        }
    }

    // prod[rows,n] = sF[rows,n] * cVec[n]（cVec 按 repeat 广播）
    __aicore__ inline void MulCBcast(LocalTensor<float> prod, LocalTensor<float> sF, LocalTensor<float> cVec,
                                     int32_t rows, int32_t n)
    {
        const uint8_t rep = static_cast<uint8_t>(n / SLOT);
        const int32_t step = (n >= REP_ELEMS) ? REP_ELEMS : SLOT;
        for (int32_t off = 0; off < n; off += step) {
            const int32_t left = n - off;
            const uint64_t mask = static_cast<uint64_t>(left < step ? left : step);
            BinaryRepeatParams rp(1, 1, 1, rep, rep, 0);
            Mul(prod[off], sF[off], cVec[off], mask, static_cast<uint8_t>(rows), rp);
        }
    }

    // 行内求和：prod[rows,n] -> dst[rows]
    //
    // R5-C1a（PLUT-215 round 5）：整 repeat 归约的 mask 上限就是一次 repeat 的 fp32 元素数
    // （REP_ELEMS=64），mask=64 与 mask=8 同为一条指令。所以宽归约只要「一次 mask=64 的 Add 把
    // n 折到 ≤64 lane + 一次归约」，而精确树形要 4 次「逐级变窄 mask」的 Add（64/32/16/8）+ 一次
    // mask=8 归约 —— 那 3 次窄 mask 的 Add 每条仍是整条指令的开销，纯用指令数换 lane 数。
    //
    // 但宽归约的 64→1 内部树形与精确树形不同，fp32 上不可接受：实测 fp32 全量 334 例出现
    // p0022_fp32_s03_opz_t128 单点 max_abs_error 0.0315 > 允许 0.01（该点 golden 2984.27，
    // ULP=2.44e-4 ⇒ 32*ULP=0.0078 < 兜底 0.01）。注意同一例的基线绝对误差更大（0.0469），
    // 只是落在 golden=60566.84 的元素上（32*ULP=0.125 ⇒ 允许 0.125）。即判据的允许值随
    // 「最大误差点自身的 golden 量级」浮动，这条 case 的 fp32 归约是刀锋，不允许改舍入顺序。
    // 因此：fp32 走精确树形（与 round 4 逐字一致），16 位输出走宽归约 —— 16 位结果在落盘时
    // 先按输出 dtype 收窄（CAST_RINT），归约顺序差远小于半个 ULP，判据也是 32*ULP 口径。
    __aicore__ inline void RowSumDot(LocalTensor<float> dst, LocalTensor<float> prod, int32_t rows, int32_t n,
                                     int32_t nBlocks, bool wideReduce)
    {
        const uint8_t rep = static_cast<uint8_t>(nBlocks);
        if (wideReduce) {
            int32_t len = n;
            while (len > REP_ELEMS) {
                const int32_t half = len / 2;
                const int32_t m = (half < REP_ELEMS) ? half : REP_ELEMS;
                BinaryRepeatParams rp(1, 1, 1, rep, rep, rep);
                Add(prod, prod, prod[half], static_cast<uint64_t>(m), static_cast<uint8_t>(rows), rp);
                len = half;
            }
            ReduceRepeat<ReduceType::SUM>(dst, prod, len, static_cast<int32_t>(rows), 1, 1,
                                          static_cast<int32_t>(nBlocks));
            return;
        }
        int32_t pow2 = 1;
        while (pow2 * 2 <= n) {
            pow2 *= 2;
        }
        if (pow2 != n) {
            BinaryRepeatParams rp(1, 1, 1, rep, rep, rep);
            Add(prod, prod, prod[pow2], static_cast<uint64_t>(n - pow2), static_cast<uint8_t>(rows), rp);
        }
        int32_t len = pow2;
        while (len > SLOT) {
            const int32_t half = len / 2;
            BinaryRepeatParams rp(1, 1, 1, rep, rep, rep);
            Add(prod, prod, prod[half], static_cast<uint64_t>(half), static_cast<uint8_t>(rows), rp);
            len = half;
        }
        ReduceRepeat<ReduceType::SUM>(dst, prod, SLOT, static_cast<int32_t>(rows), 1, 1, static_cast<int32_t>(nBlocks));
    }

    public:
    // ============================================================ PLUT-132 R2：Cube 通路
    // AIV 侧只做「备料 + 收尾」，把三组点积交给同核 AIC：
    //   AIC: P^T = Bc·Cpad^T;  out_r = aState·Cpad^T + W·P^T;  S_cube = W·bc_nk
    // AIV: 写 W / bc_nk / Bc / Cpad / aState -> F1 -> 等 F2 -> sF += S_cube; out_r 转置后接 v4 收尾
    __aicore__ inline void SetCubeScratch(GM_ADDR scratch) { cubeScratch_ = scratch; }

    __aicore__ inline void ProcessCube()
    {
        const int64_t grid = t_->grid;
        const int64_t step = t_->blockNum;  // mix 核 1 AIC : 1 AIV ⇒ AIV 个数 = blockDim
        pipe_->InitBuffer(bufCube_, 2 * AlignBytes(MAMBA3_CUBE_KV * Mamba3CubeNPad(t_->dState) * 4));
        pipe_->InitBuffer(bufCubeW_, AlignBytes(MAMBA3_CUBE_KV * t_->chunkRows * 4));
        pipe_->InitBuffer(bufCubeOrr_, AlignBytes(2 * MAMBA3_CUBE_KV * t_->chunkRows * 4));
        // R7：UB 内 Gather 转置的暂存（各 1024 个 4 B 元素，与 TransposeStore 的 STEP 一致）
        pipe_->InitBuffer(bufCubeTx_, 1024 * 4);
        pipe_->InitBuffer(bufCubeOff_, 1024 * 4);
        pipe_->InitBuffer(bufCubeAux_, 1024 * 4);
        // R8：转置偏移表专用（标量写，见下方 BuildTransTables）
        pipe_->InitBuffer(bufCubeT1_, 1024 * 4);
        pipe_->InitBuffer(bufCubeT2_, 1024 * 4);
        BuildTransTables();
        for (int64_t idx = GetBlockIdx(); idx < grid; idx += step) {
            const int64_t td = idx % t_->dTiles;
            const int64_t rest = idx / t_->dTiles;
            const int64_t hh = rest % t_->heads;
            const int64_t bb = rest / t_->heads;
            ProcessTileCube(bb, hh, td * t_->tileD, idx);
        }
    }

    // ---- R7 定界结论（2026-10-30T21:15Z）：转置不能靠 4 B 跨步的 DataCopyPad ----
    // DataCopyPad 的 UB 侧地址按 32 B 推进：blockLen < 32 B 时不再按 blockLen 累加（对齐搬运
    // 的实现见 kernel_operator_data_copy_impl.h:513 → copy_ubuf_to_gm_align_b32，burst 长度以
    // 32 B 为单位）。所以「一次搬一列、blockLen = 4 B」会把数据落到 8 的整数倍位置，实测：
    //   * 落盘：S_cube 输出里 out[n] = B[8n]（bc_nk[n][0] 拿到 B[8n]）；
    //   * 读回：out_r 读成 out[8j+i] = out_r[j]（同一 8 步长）。
    // 而门里同一几何（rows64 / k16 / n128 / bLayout1）全绿 —— 说明错在 AIV 的落盘/读回，
    // 与 Cube 参数、分形排布无关。改法：GM 侧只做 32 B 对齐的整体搬运，转置在 UB 里用 Gather 做。
    // 偏移表（[16][pitch] -> [pitch][16]）：off[i] = (i & 15) * pitch + (i >> 4)，单位字节。
    // R8：这张表**必须标量写**。本 arch 上一次 Level-2 向量调用只落 8 个 repeat（= 512 个 b32），
    // count 给 1024 时只有前 512 项正确、后 512 项被写成常量（实测 512..1023 全是 3968），
    // 于是转置只落一半（[64][16] 只写前 32 行），S_cube 随之只剩 32×64。
    // 表只与几何有关，每 launch 建一次即可，量级 2048 次标量写。
    __aicore__ inline void BuildTransTables()
    {
        LocalTensor<int32_t> t1 = bufCubeT1_.Get<int32_t>();   // pitch = chunkRows
        LocalTensor<int32_t> t2 = bufCubeT2_.Get<int32_t>();   // pitch = nPad
        const int32_t pr = static_cast<int32_t>(t_->chunkRows);
        const int32_t pb = static_cast<int32_t>(Mamba3CubeNPad(t_->dState));
        for (int32_t i = 0; i < 1024; ++i) {
            const int32_t k = i & 15;
            const int32_t n = i >> 4;
            t1.SetValue(i, (k * pr + n) * static_cast<int32_t>(sizeof(float)));
            t2.SetValue(i, (k * pb + n) * static_cast<int32_t>(sizeof(float)));
        }
        SetFlag<HardEvent::S_V>(static_cast<event_t>(EVENT_ID5));
        WaitFlag<HardEvent::S_V>(static_cast<event_t>(EVENT_ID5));
    }

    // vgather 一次 repeat 只覆盖 64 个 b32 元素（mask 计数上限），且实测 repeatTimes 给 16 时
    // 只有前 8 个 repeat 生效（1024 个元素里只有前 512 个被写对，其余保持旧值）。故按 8 个
    // repeat（512 元素）一块显式下发，剩余不足 64 的尾巴单独一次。
    __aicore__ inline void GatherN(LocalTensor<float> dst, LocalTensor<float> src, LocalTensor<uint32_t> offU,
                                   uint32_t baseBytes, int32_t count)
    {
        constexpr int32_t REP = 8;          // 每次调用最多 8 个 repeat = 512 个元素
        int32_t done = 0;
        while (done < count) {
            int32_t m = count - done;
            if (m > REP * 64) {
                m = REP * 64;
            }
            const int32_t reps = m / 64;    // 整 64 个一段，用 repeatTimes 展开
            if (reps > 0) {
                Gather(dst[done], src, offU[done], baseBytes, static_cast<uint64_t>(64),
                       static_cast<uint8_t>(reps), static_cast<uint16_t>(8));
                done += reps * 64;
                continue;
            }
            Gather(dst[done], src, offU[done], baseBytes, static_cast<uint64_t>(m), static_cast<uint8_t>(1),
                   static_cast<uint16_t>(1));
            done += m;
        }
    }

    // UB 里 [16][pitch] 的矩阵整体转置成 [pitch][16] 落 GM（dst 行 pitch = 16，32 B 对齐）
    __aicore__ inline void TransposeStore(GM_ADDR gm, LocalTensor<float> src, int32_t pitch, int32_t cnt)
    {
        constexpr int32_t STEP = 1024;    // = bufCubeTx_ / bufCubeT1_ / bufCubeT2_ 的元素数
        const int32_t nPad = static_cast<int32_t>(Mamba3CubeNPad(t_->dState));
        LocalTensor<uint32_t> offU = (pitch == nPad) ? bufCubeT2_.Get<uint32_t>() : bufCubeT1_.Get<uint32_t>();
        LocalTensor<float> tx = bufCubeTx_.Get<float>();
        GlobalTensor<float> g;
        g.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(gm));
        for (int32_t done = 0; done < cnt; done += STEP) {
            const int32_t m = ((cnt - done) < STEP) ? (cnt - done) : STEP;
            // 注意：Gather 的 srcBaseOffset 单位是**字节**（impl 里直接加到源地址上：
            // uint32_t offsetAddr = (uint64_t)srcLocal + srcBaseOffset），每块起始 = done/16 个元素。
            GatherN(tx, src, offU, static_cast<uint32_t>((done / 16) * static_cast<int32_t>(sizeof(float))), m);
            SyncVecToMte3();
            DataCopy(g[static_cast<int64_t>(done)], tx, static_cast<uint32_t>(m));
            SyncMte3ToVec();
        }
    }

    __aicore__ inline void ProcessTileCube(int64_t bb, int64_t hh, int64_t d0, int64_t jobIdx)
    {
        const int64_t n = t_->dState;
        const int64_t rank = t_->rank;
        const int64_t tileD = t_->tileD;
        const int64_t rows = t_->chunkRows;
        const int64_t rb = t_->rankBlock;
        const int32_t nPad = static_cast<int32_t>(Mamba3CubeNPad(n));
        const int32_t dtState = static_cast<int32_t>(t_->dtypeState);
        const int32_t dtBC = static_cast<int32_t>(t_->dtypeBC);
        const int32_t dtX = static_cast<int32_t>(t_->dtypeX);
        const int32_t dtProj = static_cast<int32_t>(t_->dtypeProj);
        const int32_t dtScalar = static_cast<int32_t>(t_->dtypeScalar);
        const int64_t eszState = static_cast<int64_t>(ElemSize(dtState));
        const int64_t eszBC = static_cast<int64_t>(ElemSize(dtBC));
        const int64_t eszX = static_cast<int64_t>(ElemSize(dtX));
        const int64_t eszProj = static_cast<int64_t>(ElemSize(dtProj));
        const int64_t eszScalar = static_cast<int64_t>(ElemSize(dtScalar));
        const int32_t rowsI = static_cast<int32_t>(rows);
        const int32_t nI = static_cast<int32_t>(n);
        const int32_t planeI = static_cast<int32_t>(rows * n);
        // 1 AIC : 1 AIV ⇒ 本 AIV 独占一段 scratch，段号就是自己的 GetBlockIdx()；
        // 布局按 pad 后的 n（nPad）计，与 AIC 侧 Mamba3CubeScratchOf(rows_, nPad_) 同一把尺子
        // （dState 非 16 倍数时两者才不同，生产 128 时相同）。
        const Mamba3CubeScratch cs = Mamba3CubeScratchOf(rows, nPad);
        __gm__ float *sbase =
            reinterpret_cast<__gm__ float *>(cubeScratch_) + static_cast<int64_t>(GetBlockIdx()) * cs.total;

        LocalTensor<uint8_t> raw = bufRaw_.Get<uint8_t>();
        LocalTensor<uint8_t> wb = bufWb_.Get<uint8_t>();
        LocalTensor<uint8_t> outRaw = bufOutRaw_.Get<uint8_t>();
        LocalTensor<float> outF = bufOutF_.Get<float>();
        LocalTensor<uint8_t> bcStage = bufBcStage_.Get<uint8_t>();
        LocalTensor<uint8_t> projStage = bufProjStage_.Get<uint8_t>();
        LocalTensor<uint8_t> vecStage = bufVecStage_.Get<uint8_t>();
        LocalTensor<uint8_t> scalarStage = bufScalarStage_.Get<uint8_t>();
        LocalTensor<float> sF = bufS_.Get<float>();
        LocalTensor<float> prod = bufProd_.Get<float>();
        LocalTensor<float> bcf = bufBc_.Get<float>();
        LocalTensor<float> projf = bufProj_.Get<float>();
        LocalTensor<float> xF = bufX_.Get<float>();
        LocalTensor<float> xsF = bufXs_.Get<float>();
        LocalTensor<float> zF = bufZ_.Get<float>();
        LocalTensor<float> uF = bufU_.Get<float>();
        LocalTensor<float> vF = bufV_.Get<float>();
        LocalTensor<float> dxF = bufDx_.Get<float>();
        LocalTensor<float> tmpV = bufTmp_.Get<float>();
        LocalTensor<float> gateV = bufGate_.Get<float>();
        LocalTensor<float> accV = bufAcc_.Get<float>();
        LocalTensor<float> w8 = bufW8_.Get<float>();
        LocalTensor<float> orrSt = bufCubeOrr_.Get<float>();  // [16][rows] out_r 读回（后半段）
        LocalTensor<float> wtCube = bufCubeW_.Get<float>();   // [16][rows] W 的 k 行暂存
        LocalTensor<float> scalarF = bufScalar_.Get<float>();
        LocalTensor<float> expTmp = bufExpTmp_.Get<float>();
        LocalTensor<float> trSt = bufCube_.Get<float>();  // [16][nPad] 转置暂存（源/目的各一半）

        const int64_t rbNStride = AlignBytes(rb * n * eszBC);
        const int64_t rbRowStride = AlignBytes(rb * rows * eszProj);
        const int64_t vecRowStride = AlignBytes(rows * eszX);
        const int64_t rbNF = AlignBytes(rb * n * 4);
        const int64_t rbRowF = AlignBytes(rb * rows * 4);

        LocalTensor<float> bF = bcf;
        LocalTensor<float> bsF = bcf[rbNF / 4];
        LocalTensor<float> cF = bcf[2 * (rbNF / 4)];
        LocalTensor<float> xpF = projf;
        LocalTensor<float> opF = projf[rbRowF / 4];
        LocalTensor<float> zpF = projf[2 * (rbRowF / 4)];

        // ---- 标量: alpha / beta / gamma（与 v4 同口径）----
        SyncVecToMte2();
        LoadRows(scalarStage, a_, (bb * t_->sAB + hh * t_->sAH) * eszScalar, 1, 1, 1, dtScalar);
        LoadRows(scalarStage[32], dt_, (bb * t_->sDtB + hh * t_->sDtH) * eszScalar, 1, 1, 1, dtScalar);
        LoadRows(scalarStage[64], trap_, (bb * t_->sTrapB + hh * t_->sTrapH) * eszScalar, 1, 1, 1, dtScalar);
        LoadRows(scalarStage[96], d_, hh * t_->sDh * eszScalar, 1, 1, 1, dtScalar);
        SyncMte2ToVec();
        StageToFp32(scalarF, scalarStage, 1, dtScalar);
        StageToFp32(scalarF[8], scalarStage[32], 1, dtScalar);
        StageToFp32(scalarF[16], scalarStage[64], 1, dtScalar);
        StageToFp32(scalarF[24], scalarStage[96], 1, dtScalar);
        SyncVecToScalar();
        const float aVal = scalarF.GetValue(0);
        const float dtVal = scalarF.GetValue(8);
        const float trapVal = scalarF.GetValue(16);
        const float dVal = scalarF.GetValue(24);
        Duplicate(expTmp, aVal * dtVal, SLOT);
        Exp(expTmp, expTmp, SLOT);
        SyncVecToScalar();
        const float alpha = expTmp.GetValue(0);
        const float gamma = trapVal * dtVal;
        const float beta = (1.0f - trapVal) * dtVal * alpha;

        const int64_t chunks = tileD / rows;
        for (int64_t c = 0; c < chunks; ++c) {
            const int64_t d0c = d0 + c * rows;
            SyncVecToMte2();

            const int32_t rankCur = static_cast<int32_t>(rank < rb ? rank : rb);
            LoadRows(raw, state_, (bb * t_->sStateB + hh * t_->sStateH + d0c * t_->sStateD) * eszState, rowsI, nI,
                     t_->sStateD, dtState);
            LoadRows(bcStage, b_, (bb * t_->sBB + hh * t_->sBH) * eszBC, rankCur, nI, t_->sBR, dtBC);
            LoadRows(bcStage[rbNStride], bstate_, (bb * t_->sBstateB + hh * t_->sBstateH) * eszBC, rankCur, nI,
                     t_->sBstateR, dtBC);
            LoadRows(bcStage[2 * rbNStride], c_, (bb * t_->sCB + hh * t_->sCH) * eszBC, rankCur, nI, t_->sCR, dtBC);
            LoadRows(projStage, xproj_, (hh * t_->sXprojH + d0c) * eszProj, rankCur, rowsI, t_->sXprojR, dtProj);
            if (t_->hasOutproj != 0) {
                LoadRows(projStage[rbRowStride], outproj_, (hh * t_->sOutprojH + d0c) * eszProj, rankCur, rowsI,
                         t_->sOutprojR, dtProj);
            }
            if (t_->hasZ != 0) {
                LoadRows(projStage[2 * rbRowStride], zproj_, (hh * t_->sZprojH + d0c) * eszProj, rankCur, rowsI,
                         t_->sZprojR, dtProj);
            }
            LoadRows(vecStage, x_, (bb * t_->sXB + hh * t_->sXH + d0c) * eszX, 1, rowsI, rowsI, dtX);
            LoadRows(vecStage[vecRowStride], xstate_, (bb * t_->sXstateB + hh * t_->sXstateH + d0c) * eszX, 1,
                     rowsI, rowsI, dtX);
            if (t_->hasZ != 0) {
                LoadRows(vecStage[2 * vecRowStride], z_, (bb * t_->sZB + hh * t_->sZH + d0c) * eszX, 1, rowsI,
                         rowsI, dtX);
            }
            SyncMte2ToVec();

            StageToFp32(xF, vecStage, rowsI, dtX);
            StageToFp32(xsF, vecStage[vecRowStride], rowsI, dtX);
            if (t_->hasZ != 0) {
                StageToFp32(zF, vecStage[2 * vecRowStride], rowsI, dtX);
            }
            Muls(uF, xF, gamma, rowsI);
            Muls(vF, xsF, beta, rowsI);
            Muls(dxF, xF, dVal, rowsI);
            StageToFp32(bF, bcStage, rankCur * nI, dtBC);
            StageToFp32(bsF, bcStage[rbNStride], rankCur * nI, dtBC);
            StageToFp32(cF, bcStage[2 * rbNStride], rankCur * nI, dtBC);
            StageToFp32(xpF, projStage, rankCur * rowsI, dtProj);
            if (t_->hasOutproj != 0) {
                StageToFp32(opF, projStage[rbRowStride], rankCur * rowsI, dtProj);
            }
            if (t_->hasZ != 0) {
                StageToFp32(zpF, projStage[2 * rbRowStride], rankCur * rowsI, dtProj);
            }
            StageScaleToFp32(sF, raw, planeI, dtState, alpha);  // sF = alpha * state

            // ---------------- 备料（全部 fp32，写进本核 scratch）----------------
            // (a) Cpad [16][nPad]：r < R 为 C，其余行补 0（Cube 侧 m/n 都按 16 对齐）
            Duplicate(trSt, 0.0f, MAMBA3_CUBE_KV * nPad);
            SyncVecToMte2();
            for (int32_t r = 0; r < rankCur; ++r) {
                DataCopy(trSt[r * nPad], cF[r * nI], static_cast<uint32_t>(nI));
            }
            SyncVecToMte3();
            {
                GlobalTensor<float> g;
                g.SetGlobalBuffer(sbase + cs.cp);
                DataCopy(g, trSt, static_cast<uint32_t>(MAMBA3_CUBE_KV * nPad));
            }
            // (b) Bc [16][nPad] -> bk，再转置成 bc_nk [nPad][16] -> bc
            SyncMte3ToVec();
            Duplicate(trSt, 0.0f, MAMBA3_CUBE_KV * nPad);
            SyncVecToMte2();
            for (int32_t r = 0; r < rankCur; ++r) {
                DataCopy(trSt[r * nPad], bF[r * nI], static_cast<uint32_t>(nI));
                DataCopy(trSt[(rankCur + r) * nPad], bsF[r * nI], static_cast<uint32_t>(nI));
            }
            SyncVecToMte3();
            {
                GlobalTensor<float> g;
                g.SetGlobalBuffer(sbase + cs.bk);
                DataCopy(g, trSt, static_cast<uint32_t>(MAMBA3_CUBE_KV * nPad));
            }
            SyncVecToMte3();
            // bc_nk[n][k] = Bc[k][n]：[nPad][16] 整体落盘（UB 内 Gather 转置，32 B 对齐）
            TransposeStore(reinterpret_cast<GM_ADDR>(sbase + cs.bc), trSt, nPad,
                           MAMBA3_CUBE_KV * nPad);
            // (c) W [rows][16]：列 k<R 为 u*xproj[r]，列 R<=k<2R 为 v*xproj[r]（同 v4 的 w1/w2）
            SyncMte3ToVec();
            {
                LocalTensor<float> wt = wtCube;  // [16][rows]，k 为行（R7：独立缓冲，不再借用 bufW8_）
                Duplicate(wt, 0.0f, static_cast<int32_t>(16 * rows));
                SyncVecToMte2();
                for (int32_t r = 0; r < rankCur; ++r) {
                    Mul(wt[r * rowsI], uF, xpF[r * rowsI], rowsI);
                    Mul(wt[(rankCur + r) * rowsI], vF, xpF[r * rowsI], rowsI);
                }
                SyncVecToMte3();
                // W[d][k] = wt[k][d]：[rows][16] 整体落盘（UB 内 Gather 转置，列 k>=2R 为 0）
                TransposeStore(reinterpret_cast<GM_ADDR>(sbase + cs.w), wt, rowsI,
                               MAMBA3_CUBE_KV * rowsI);
            }
            // (d) aState [rows][nPad] = sF
            SyncMte3ToVec();
            SyncVecToMte3();
            {
                GlobalTensor<float> g;
                g.SetGlobalBuffer(sbase + cs.ac);
                if (nI == nPad) {
                    DataCopy(g, sF, static_cast<uint32_t>(planeI));
                } else {
                    // R7：scratch 的行 pitch 是 nPad，sF 是紧凑 [rows][n]，dState 非 16 倍数时必须按行跨步落盘
                    // （此前直接 DataCopy 紧凑 planeI，n<nPad 时第 1 行起整体错位）。
                    DataCopyExtParams cp{static_cast<uint16_t>(rowsI), static_cast<uint32_t>(nI * 4), 0u,
                                         static_cast<uint32_t>((nPad - nI) * 4), 0u};
                    DataCopyPad(g, sF, cp);
                }
            }
            // ---------------- F1（V->C）/ F2（C->V），方向由置位核 + flag id 决定 ----------------
            // 1 AIC : 1 AIV ⇒ 单 id、单次置位（置位次数与 AIC 的等待次数严格 1:1）。
            // 2026-10-30 第五轮：mode 模板参数按**实测唯一可投递**的取值写。
            // 探针里 AIV->AIC 只有 mode=2 这组验通过（n11b，aic_marker=900）；上一轮写 mode=1
            // 是照枚举名字猜的方向，从未单独验过（当时和「AIC 等两次」混在一起测，结论不可用）。
            // 等待侧不看 mode（sync_impl.h:490-491），所以只需置位侧与实测一致。
            CrossCoreSetFlag<2, PIPE_MTE3>(MAMBA3_CC_F1_ID);

            // ---------------- 收尾：sF += S_cube（S_cube 已覆盖 aState 那块）----------------
            CrossCoreWaitFlag<2, PIPE_MTE2>(MAMBA3_CC_F2_ID);
            SyncMte3ToVec();
            {
                GlobalTensor<float> g;
                g.SetGlobalBuffer(sbase + cs.ac);
                if (nI == nPad) {
                    DataCopy(prod, g, static_cast<uint32_t>(planeI));
                } else {
                    // R7：S_cube 落盘行 pitch 是 nPad，读回同样按行跨步（见上面 aState 落盘的同一处修正）
                    DataCopyExtParams cp{static_cast<uint16_t>(rowsI), static_cast<uint32_t>(nI * 4),
                                         static_cast<uint32_t>((nPad - nI) * 4), 0u, 0u};
                    DataCopyPadExtParams<float> pp{false, 0, 0, 0};
                    DataCopyPad(prod, g, cp, pp);
                }
            }
            SyncMte2ToVec();
            Add(sF, sF, prod, planeI);

            // out_r [rows][16] 整块读回（32 B 对齐），再在 UB 里按列 Gather 成 [16][rows]
            // （第 r 行 = rank r 的整列）
            SyncVecToMte2();
            {
                GlobalTensor<float> g;
                g.SetGlobalBuffer(sbase + cs.orr);
                DataCopy(orrSt, g, static_cast<uint32_t>(MAMBA3_CUBE_KV * rowsI));
            }
            SyncMte2ToVec();
            {
                LocalTensor<int32_t> baseI = bufCubeOff_.Get<int32_t>();
                LocalTensor<int32_t> colI = bufCubeAux_.Get<int32_t>();
                LocalTensor<uint32_t> colU = bufCubeAux_.Get<uint32_t>();
                CreateVecIndex(baseI, 0, rowsI);
                Muls(baseI, baseI, static_cast<int32_t>(MAMBA3_CUBE_KV * sizeof(float)), rowsI);  // i*16 字节
                for (int32_t r = 0; r < rankCur; ++r) {
                    Adds(colI, baseI, r * static_cast<int32_t>(sizeof(float)), rowsI);
                    GatherN(orrSt[rowsI * 16 + r * rowsI], orrSt, colU, 0u, rowsI);
                }
            }

            // ---------------- 与 v4 相同的出口 ----------------
            LocalTensor<float> oT = orrSt[rowsI * 16];
            if (t_->hasOutproj != 0) {
                Duplicate(accV, 0.0f, rowsI);
            }
            for (int32_t i = 0; i < rankCur; ++i) {
                LocalTensor<float> rowV = oT[i * rowsI];
                Mul(tmpV, dxF, xpF[i * rowsI], rowsI);
                Add(rowV, rowV, tmpV, rowsI);
                if (t_->hasOutproj != 0) {
                    if (t_->hasZ != 0) {
                        Mul(gateV, zF, zpF[i * rowsI], rowsI);
                        Sigmoid(tmpV, gateV, static_cast<uint32_t>(rowsI));
                        Mul(gateV, gateV, tmpV, rowsI);
                        Mul(rowV, rowV, gateV, rowsI);
                    }
                    MulAddDst(accV, rowV, opF[i * rowsI], rowsI);
                } else {
                    Muls(outF[i * rowsI], rowV, 1.0f, rowsI);
                }
            }
            if (t_->hasOutproj != 0) {
                Fp32ToStage(outRaw, accV, rowsI, dtX);
                SyncVecToMte3();
                const int64_t outByte = (bb * t_->sOutB + hh * t_->sOutH + d0c) * eszX;
                StoreRows(out_, outByte, 1, rowsI, rowsI, dtX, outRaw);
                SyncMte3ToVec();
            } else {
                Fp32ToStage(outRaw, outF, static_cast<int32_t>(rank) * rowsI, dtX);
                SyncVecToMte3();
                const int64_t outByte = (bb * t_->sOutB + hh * t_->sOutH + d0c) * eszX;
                StoreRows(out_, outByte, static_cast<int32_t>(rank), rowsI, t_->sOutR, dtX, outRaw);
                SyncMte3ToVec();
            }
            Fp32ToStage(wb, sF, planeI, dtState);
            SyncVecToMte3();
            const int64_t stateOutByte =
                (bb * t_->sStateOutB + hh * t_->sStateOutH + d0c * t_->sStateOutD) * eszState;
            StoreRows(stateOut_, stateOutByte, rowsI, nI, t_->sStateOutD, dtState, wb);
            SyncMte3ToVec();
            PipeBarrier<PIPE_ALL>();
            (void)jobIdx;
        }
    }

    private:
    // ------------------------------------------------------------------ 成员
    TPipe *pipe_;
    __gm__ Mamba3DecodeStepTiling *t_;

    GM_ADDR state_;
    GM_ADDR bstate_;
    GM_ADDR xstate_;
    GM_ADDR a_;
    GM_ADDR b_;
    GM_ADDR c_;
    GM_ADDR d_;
    GM_ADDR x_;
    GM_ADDR dt_;
    GM_ADDR trap_;
    GM_ADDR xproj_;
    GM_ADDR outproj_;
    GM_ADDR z_;
    GM_ADDR zproj_;
    GM_ADDR stateOut_;
    GM_ADDR out_;

    TBuf<TPosition::VECCALC> bufRaw_;
    TBuf<TPosition::VECCALC> bufWb_;
    TBuf<TPosition::VECCALC> bufOutRaw_;
    TBuf<TPosition::VECCALC> bufOutF_;
    TBuf<TPosition::VECCALC> bufBcStage_;
    TBuf<TPosition::VECCALC> bufProjStage_;
    TBuf<TPosition::VECCALC> bufVecStage_;
    TBuf<TPosition::VECCALC> bufScalarStage_;
    TBuf<TPosition::VECCALC> bufS_;
    TBuf<TPosition::VECCALC> bufProd_;
    TBuf<TPosition::VECCALC> bufBc_;
    TBuf<TPosition::VECCALC> bufProj_;
    TBuf<TPosition::VECCALC> bufX_;
    TBuf<TPosition::VECCALC> bufXs_;
    TBuf<TPosition::VECCALC> bufZ_;
    TBuf<TPosition::VECCALC> bufU_;
    TBuf<TPosition::VECCALC> bufV_;
    TBuf<TPosition::VECCALC> bufDx_;
    TBuf<TPosition::VECCALC> bufW_;
    TBuf<TPosition::VECCALC> bufDot_;
    TBuf<TPosition::VECCALC> bufTmp_;
    TBuf<TPosition::VECCALC> bufGate_;
    TBuf<TPosition::VECCALC> bufAcc_;
    TBuf<TPosition::VECCALC> bufW8_;
    TBuf<TPosition::VECCALC> bufScalar_;
    TBuf<TPosition::VECCALC> bufExpTmp_;
    // PLUT-132 R2：Cube 通路专用（只在 ProcessCube 里 InitBuffer，v4 通路不分配）
    TBuf<TPosition::VECCALC> bufCube_;   // 2 * 16 * nPad float：16x16 转置暂存（源/目的各一半）
    // R7：以下两块此前误用 v4 的 bufW8_（rows*8）与 bufDot_（rows*8）承载 [16][rows]，
    // 实际需要 16*rows 与 2*16*rows 个 float ⇒ 越界写（rows=64 时分别为 2x / 4x）。
    // 二者都只在 Cube 通路用，故单独分配、不在 InitBuffers 里给 v4 付这份预算。
    TBuf<TPosition::VECCALC> bufCubeW_;    // 16 * rows float：W[rows][16] 的 [16][rows] 暂存（k 为行）
    TBuf<TPosition::VECCALC> bufCubeOrr_;  // 2 * 16 * rows float：out_r 读回暂存（[16][rows] + 首半偏移）
    // R7：UB 内 Gather 转置（替代此前 4 B 跨步的 DataCopyPad 转置）
    TBuf<TPosition::VECCALC> bufCubeTx_;   // 1024 float：转置结果暂存
    TBuf<TPosition::VECCALC> bufCubeOff_;  // 1024 int32/uint32：Gather 偏移表
    TBuf<TPosition::VECCALC> bufCubeAux_;  // 1024 int32：偏移表 / 列偏移暂存
    // R8：转置偏移表（标量建、每 launch 一次；向量建表在本 arch 上只落前 512 项）
    TBuf<TPosition::VECCALC> bufCubeT1_;   // 1024 int32：pitch = chunkRows
    TBuf<TPosition::VECCALC> bufCubeT2_;   // 1024 int32：pitch = nPad
    GM_ADDR cubeScratch_ = nullptr;      // 每 AIV 一块（Mamba3CubeScratchOf 描述）
    // PLUT-215 R4-P0：state_out 的 MTE3 落盘是否仍在飞行（跨 chunk / 跨 job 的延迟收口标记）
    bool storePending_ = false;
};

}  // namespace Mamba3DecodeStep

extern "C" __global__ __vector__ void mamba3_decode_step(
    GM_ADDR state, GM_ADDR bstate, GM_ADDR xstate, GM_ADDR aGm, GM_ADDR bGm, GM_ADDR cGm, GM_ADDR dGm,
    GM_ADDR xGm, GM_ADDR dtGm, GM_ADDR trapGm, GM_ADDR xprojGm, GM_ADDR outprojGm, GM_ADDR zGm,
    GM_ADDR zprojGm, GM_ADDR stateOutGm, GM_ADDR outGm, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    Mamba3DecodeStep::Kernel op(&pipe);
    op.Init(state, bstate, xstate, aGm, bGm, cGm, dGm, xGm, dtGm, trapGm, xprojGm, outprojGm, zGm, zprojGm,
            stateOutGm, outGm, tiling);
    op.Process();
}

// ============================================================================
// AIC（Cube）分支骨架 -- PLUT-132（G1 前置；m 与 n 都按 16 分块）
//
// 通路：GM --DataCopy(Nd2Nz)--> L1 --LoadData--> L0A/L0B --Mmad--> L0C
//          --Fixpipe(mSize=mSize, nSize=nSize, dstStride=行 pitch, ndNum=1, srcStride=0)--> GM(ND)
//
// 交付经理 2026-10-30T16:41Z 四条硬条件，逐条落在下面：
//   1. 分块常数化：Fixpipe 的 n 形式只在 PLUT132_FIXPIPE_TILE_N /
//      PLUT132_FIXPIPE_SRC_STRIDE / PLUT132_FIXPIPE_LD 三处表达；
//   2. 不扫 srcStride：0 是已实测值（nSize=16 下），取 1 会 aicore exception；
//   3. 代价不再写「量级可忽略」：perf-1/2/3/6/8 逐例的「瓦片数 × Mmad 数 + Fixpipe 条数 +
//      每 job 落盘字节 + 一阶 μs 估计」见 docs/results/plut132-aic-cost-model.md；
//   4. dstStride 恒 = PLUT132_FIXPIPE_LD = 16（已实测值，单位 = 元素），落盘 = 瓦片连续排
//      （tile-major）：瓦片 (mi, nj) 落在 cGm + (mi * nBlocks + nj) * 256 个 float 处，
//      AIV 侧按索引图重组；不把 dstStride 推成 nSize 去「顺手连续」。
//
// 本轮边界（2026-10-30 第三轮：n 分块对照实验已做，结论写在这里，不留给文档去圆）：
//   * 「n 必须按 16 切」这件事**没有报错级证据**：真正能做的是把 n 分块做成旋钮，用同一段代码两试。
//     两试都在 910B3 上跑了（证据 docs/results/plut132-aic-fulln-probe.json）：
//       - nMode=0（切块，一瓦片一条 Mmad + 一条 Fixpipe）：identity 0.0、random 4.36e-06，绿；
//       - nMode=1（Mmad 一次吃满 n + 一条 Fixpipe 落 n>16，srcStride 取 CANN 定义值 CeilAlign(m,16)=16）：
//         n=32 identity 3.98、n=128 identity 5.25/6.19、random 43.7，红；
//       - nMode=2（单次 Mmad(n>16) + 每 16 列一条 Fixpipe）：与 nMode=1 **数字逐位相同**，红，
//         说明红点不在 Fixpipe 的 n 迭代上，而在 Mmad(n>16) 落到 L0C 的形态上（可解码输入实验复现：
//         16 行里只读出 8 行、另 8 行重复）。
//     即：A 试没通过，且拿不到「设备原文错误」——两条路都是**静默错数**，没有 errorStr/retCode。
//     所以本分支既不宣称「36 条是 API 唯一形态」，也不宣称「8 条可行」，只保留唯一实测绿的形态；
//   * mFix=1（一条 Fixpipe 落 mSize=rows>16）实测**一个字节都没写出来**，B 试同样不成立；
//   * k <= 64，fp32 原生（D1 取证：路线 A，不是 bf16 三次拆解）；
//   * 不接 AIV 侧 C 转置、不接 CrossCore F1/F2/F3、不接 op 入口 —— op 入口
//     `mamba3_decode_step` 仍是纯 v4、一行未改；本段只由自测门
//     `mamba3_decode_step_cube_gate` 驱动。
//
// 参数口径全部来自 910B3 实测（docs/results/plut130-cube-l1-path-probe.json +
// plut130-cube-fixpipe-nd-probe.json + plut132-aic-l1-gate.json），不按文档推导：
//   Nd2Nz:    dstNzC0Stride = 该矩阵的 ND 行数（单位 32 B）、dstNzNStride = 1
//   LoadData: srcStride = 1（分形在 L1 中连续）、repeatTimes = k / 8（一个 16 行瓦片）
//   Fixpipe:  dstStride = ND 行 pitch（元素）、ndNum = 1、nSize / mSize = 16
// ============================================================================
namespace Mamba3DecodeStep {

// ---- Fixpipe 的 n 形式：只在这三处表达（硬条件 1/2/4）----
constexpr int32_t PLUT132_FIXPIPE_TILE_N = 16;     // 一次 Fixpipe 落的 n 宽 = 一个 n 分形（实测）
constexpr int32_t PLUT132_FIXPIPE_SRC_STRIDE = 0;  // 单 n 分形时该字段不参与寻址（nSize=16 实测；取 1 直崩）
constexpr int32_t PLUT132_FIXPIPE_LD = 16;         // 落盘 ND 行 pitch，单位 = 元素（span 三点实测）

// ---- 整块 n（nSize > 16 一次落盘）的 srcStride：有官方定义，不是自由参量 ----
// CANN 9.1.0 里 FixpipeParamsV220::srcStride 在 NoQuant 路径上是**原样下发**给
// copy_matrix_cc_to_gm 的（impl/basic_api/dav_c220/kernel_operator_fixpipe_v2_impl.h:390-392），
// 取值定义在官方 matmul 的 ND 落盘实现里：
//   impl/adv_api/detail/matmul/stage/copy_cube_out/copy_cube_out_utils.h:70
//     params_.srcStride = CeilAlign((IsStaticPaddingEnable(MM_CFG) ? baseHeight : mSize), BLOCK_CUBE);
// 单位 = C0_size（impl/basic_api/dav_c220/kernel_operator_fixpipe_impl.h:135-137 的注释：
// "original src_stride unit is 256 elements ... new src_burst_gap unit is C0_size,
//  for example, src dtype is b32, gap unit is 16*4"），即 16 个 fp32 = 64 B；
// 一个 16×16 fp32 分形 = 1024 B = 16 个该单位 ⇒ srcStride = CeilAlign(mSize, 16) 正好跨一个 n 分形。
// 取 0 的实测后果：8 个 n 分形全读第 0 块（见 docs/results/plut130-cube-l1-path-probe.json 的 v_n32/v_n128）。
// 但**按这条定义取值 16 也不绿**（本轮 n=32 identity 3.98 / n=128 identity 5.25，且与取 0 的错法不同）；
// 进一步用 nMode=2 把 Fixpipe 的 n 迭代摘掉后数字不变 ⇒ 红点在 Mmad(n>16) 的 L0C 输出形态，
// 不在这个字段上。这一条只作为「字段定义与单位」的引用，不作为可用配方。
constexpr int32_t PLUT132_FIXPIPE_SRC_STRIDE_N = 16;  // = CeilAlign(CUBE_M_TILE, 16)

// ---- 0a：多 n 块一次落盘的 srcNdStride 两个候选（只这两个，不扫参）----
// 单位在 CANN 9.1.0 头文件里**没有定义**：FixpipeParamsV220.{ndNum,srcNdStride,dstNdStride}
// 只被原样塞进 ND_PARA（impl/basic_api/dav_c220/kernel_operator_fixpipe_v2_impl.h:223-226 /
// :249-252），取值域由 SetFixpipeNz2ndFlag 的 0..512 校验给出
// （impl/basic_api/dav_c220/kernel_operator_fixpipe_impl.h:68 VALUE_512）。L0C 一个 16x16 fp32
// 分形 = 1024 B，于是两个自洽的候选只能是「512 B 为单位」= 2 或「一个分形为单位」= 1。
constexpr int32_t PLUT132_SRC_ND_STRIDE_512B = 2;  // 候选 1：单位 512 B（分形 = 2 单位）
constexpr int32_t PLUT132_SRC_ND_STRIDE_FRAC = 1;  // 候选 2：单位 = 一个 16x16 分形（1024 B）

constexpr int32_t CUBE_M_TILE = 16;                                         // 一个 m 分形
constexpr int32_t CUBE_FRAC_FLOATS = 128;                                   // 一个 16x8 fp32 分形 = 512 B
constexpr int32_t CUBE_TILE_FLOATS = PLUT132_FIXPIPE_TILE_N * CUBE_M_TILE;  // 落地瓦片 = 256 float = 1 KiB
constexpr int32_t CUBE_MAX_K = 64;                                          // A1/B1 容量上限（fp32 操作数）
constexpr int32_t CUBE_MAX_N = 128;                                         // 正式 Npad
constexpr int32_t CUBE_L1_A_BYTES = CUBE_M_TILE * CUBE_MAX_K * 4;
constexpr int32_t CUBE_L1_B_BYTES = CUBE_MAX_N * CUBE_MAX_K * 4;
constexpr int32_t CUBE_L0C_BYTES = CUBE_TILE_FLOATS * 4;

// 分块直通：C[rows][n] = A[rows][k] · B[n][k]^T，A/B 在 GM 里都按 k 连续摆好。
//   bLayout = 1：B 在 GM 里已是 [n][k]（k 连续）-- 实测的唯一正确摆位（host 侧 tOp=2 等价）；
//   bLayout = 0：B 在 GM 里是 [k][n]（n 连续，即 host 未转置）-- 只用来把「L1 层能不能直接把
//                [n][k] 给出来」用误差钉死，不是可选路径（这一档只按 n = 16 跑）。
//   nMode = 0：n 按 16 切块，每块一次 Mmad(n=16) + 一次 Fixpipe(nSize=16)，落盘 tile-major（上一版形态）；
//   nMode = 1：n 一次吃满（Mmad n=nSize），L0C 得一块连续 16×nSize（perf-8 = 8 KiB），
//              一次 Fixpipe(nSize=nSize, srcStride=CeilAlign(m,16), dstStride=nSize) 直接落 ND [16][nSize]；
//   mFix  = 1：只对 nSize=16 有效（out_r_pre 那一块）——各 m 分形的 L0C 地址连续（mi*256），
//              末尾用一次 Fixpipe(mSize=rows, nSize=16) 落 [rows][16]，条数从 rows/16 降到 1。
//   nMode = 3/4：**0a 实验**——Mmad 仍每 16 列一条（已验证形状），但 nBlocks 个分形合成一条
//              Fixpipe（ndNum=nBlocks、dstStride=nSize、dstNdStride=16）一次落成自然 [16][nSize]；
//              3 = srcNdStride 取 2（512 B 单位），4 = 取 1（分形单位）。条数为 mTiles（8 条/job 的目标）。
//   nMode = 5：= nMode 4（srcNdStride 取 1）但把 `mi * ndTileFloats` 去掉，每个 mi **复用**同一段
//              L0C（8 KiB），用来把「多 ND 落盘本身」与「4 个 m 块常驻 L0C（32 KiB）」两个变量拆开。
// 落盘条数由 kernel 自己数出来写到 cGm[rows*nSize]（int32），门脚本直接核对「条数 = rows/16」。
__aicore__ inline void CubeTileBody(GM_ADDR aGm, GM_ADDR bGm, GM_ADDR cGm, int32_t rows, int32_t kSize,
                                    int32_t nSize, int32_t bLayout, int32_t nMode, int32_t mFix)
{
    const int32_t mTiles = rows / CUBE_M_TILE;
    const int32_t nBlocks = nSize / PLUT132_FIXPIPE_TILE_N;

    // L0C：nMode=0 每瓦片 1 KiB；nMode=1 一块 16×nSize；nMode=3/4 每 m 块一段（nBlocks*1 KiB）；
    //      mFix=1 要装下 rows×nSize
    //      nMode=5 每个 mi 复用同一段 nBlocks 个分形 ⇒ 只占 nBlocks*1 KiB（生产几何 8 KiB）
    const int32_t c1Floats = (mFix != 0) ? (mTiles * CUBE_M_TILE * nSize)
                                         : ((nMode == 5) ? (nBlocks * CUBE_TILE_FLOATS)
                                                         : ((nMode >= 3) ? (mTiles * nBlocks * CUBE_TILE_FLOATS)
                                                                         : ((nMode != 0) ? (CUBE_M_TILE * nSize)
                                                                                         : CUBE_TILE_FLOATS)));
    TPipe pipe;
    TBuf<TPosition::A1> bufA1;
    TBuf<TPosition::B1> bufB1;
    TBuf<TPosition::A2> bufA2;
    TBuf<TPosition::B2> bufB2;
    TBuf<TPosition::CO1> bufC1;
    pipe.InitBuffer(bufA1, CUBE_L1_A_BYTES);
    pipe.InitBuffer(bufB1, CUBE_L1_B_BYTES);
    pipe.InitBuffer(bufA2, CUBE_L1_A_BYTES);
    pipe.InitBuffer(bufB2, CUBE_L1_B_BYTES);
    pipe.InitBuffer(bufC1, c1Floats * 4);

    LocalTensor<float> a1 = bufA1.Get<float>();
    LocalTensor<float> b1 = bufB1.Get<float>();
    LocalTensor<float> a2 = bufA2.Get<float>();
    LocalTensor<float> b2 = bufB2.Get<float>();
    LocalTensor<float> c1 = bufC1.Get<float>();

    GlobalTensor<float> gb;
    gb.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(bGm));

    // ---- B：只与 n / k 有关，按 m 循环之外载一次（GM --Nd2Nz--> L1 --LoadData--> L0B）----
    Nd2NzParams pb;
    pb.ndNum = 1;
    pb.dstNzNStride = 1;
    pb.dstNzMatrixStride = 0;
    pb.srcNdMatrixStride = 0;
    if (bLayout != 0) {
        pb.nValue = static_cast<uint16_t>(nSize);
        pb.dValue = static_cast<uint16_t>(kSize);
        pb.srcDValue = static_cast<uint16_t>(kSize);
        pb.dstNzC0Stride = static_cast<uint16_t>(nSize);
    } else {
        pb.nValue = static_cast<uint16_t>(kSize);
        pb.dValue = static_cast<uint16_t>(nSize);
        pb.srcDValue = static_cast<uint16_t>(nSize);
        pb.dstNzC0Stride = static_cast<uint16_t>(kSize);
    }
    DataCopy(b1, gb, pb);

    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(EVENT_ID0));
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(EVENT_ID0));

    LoadData2DParams lb;
    lb.startIndex = 0;
    lb.repeatTimes = static_cast<uint8_t>(kSize / 8);
    lb.srcStride = 1;
    lb.sid = 0;
    lb.dstGap = 0;
    lb.ifTranspose = false;
    lb.addrMode = 0;
    if (bLayout != 0) {
        // [n][k] 摆位：L1 = [k/8][n/16][16][8]，L0B 要 [n/16][k/8][16][8]
        // => 每个 n 块单独一次 LoadData：startIndex = 块号、repeatTimes = k/8、srcStride = nBlocks
        lb.srcStride = static_cast<uint16_t>(nBlocks);
        for (int32_t nj = 0; nj < nBlocks; ++nj) {
            lb.startIndex = static_cast<uint16_t>(nj);
            LoadData(b2[nj * (kSize / 8) * CUBE_FRAC_FLOATS], b1, lb);
        }
    } else {
        // [k][n] 摆位：按 A 侧同一规则整块取（「host 不转置」的候选写法，用来量它错多少）
        lb.repeatTimes = static_cast<uint8_t>((nSize / 8) * (kSize / CUBE_M_TILE));
        lb.srcStride = 1;
        LoadData(b2, b1, lb);
    }

    SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(EVENT_ID1));
    WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(EVENT_ID1));

    // ---- A：按 16 行瓦片循环（GM --Nd2Nz--> L1 --LoadData--> L0A），逐瓦片 Mmad + Fixpipe ----
    SetHF32Mode(HF32Mode::DISABLE);
    int32_t fixCount = 0;
    for (int32_t mi = 0; mi < mTiles; ++mi) {
        GlobalTensor<float> ga;
        ga.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(aGm) + mi * CUBE_M_TILE * kSize);

        Nd2NzParams pa;
        pa.ndNum = 1;
        pa.nValue = static_cast<uint16_t>(CUBE_M_TILE);
        pa.dValue = static_cast<uint16_t>(kSize);
        pa.srcNdMatrixStride = 0;
        pa.srcDValue = static_cast<uint16_t>(kSize);
        pa.dstNzC0Stride = static_cast<uint16_t>(CUBE_M_TILE);
        pa.dstNzNStride = 1;
        pa.dstNzMatrixStride = 0;
        DataCopy(a1, ga, pa);

        SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(EVENT_ID0));
        WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(EVENT_ID0));

        LoadData2DParams la;
        la.startIndex = 0;
        la.repeatTimes = static_cast<uint8_t>(kSize / 8);
        la.srcStride = 1;
        la.sid = 0;
        la.dstGap = 0;
        la.ifTranspose = false;
        la.addrMode = 0;
        LoadData(a2, a1, la);

        SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(EVENT_ID1));
        WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(EVENT_ID1));

        if (nMode == 0) {
            for (int32_t nj = 0; nj < nBlocks; ++nj) {
                MmadParams mp;
                mp.m = static_cast<uint16_t>(CUBE_M_TILE);
                mp.n = static_cast<uint16_t>(PLUT132_FIXPIPE_TILE_N);
                mp.k = static_cast<uint16_t>(kSize);
                mp.unitFlag = 0;
                mp.kDirectionAlign = false;
                mp.cmatrixSource = false;
                mp.cmatrixInitVal = true;
                Mmad(c1, a2, b2[nj * (kSize / 8) * CUBE_FRAC_FLOATS], mp);

                SetFlag<HardEvent::M_FIX>(static_cast<event_t>(EVENT_ID2));
                WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(EVENT_ID2));

                GlobalTensor<float> gc;
                gc.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(cGm) + (mi * nBlocks + nj) * CUBE_TILE_FLOATS);
                FixpipeParamsV220 fp;
                fp.nSize = static_cast<uint16_t>(PLUT132_FIXPIPE_TILE_N);
                fp.mSize = static_cast<uint16_t>(CUBE_M_TILE);
                fp.srcStride = static_cast<uint16_t>(PLUT132_FIXPIPE_SRC_STRIDE);
                fp.dstStride = static_cast<uint32_t>(PLUT132_FIXPIPE_LD);
                fp.reluEn = false;
                fp.ndNum = 1;
                Fixpipe(gc, c1, fp);
                ++fixCount;

                // 下一瓦片的 Mmad 会覆写 L0C，必须等本次 Fixpipe 读完
                SetFlag<HardEvent::FIX_M>(static_cast<event_t>(EVENT_ID3));
                WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(EVENT_ID3));
            }
        } else if (nMode == 2) {
            // 诊断支：单次 Mmad 吃满 n（L0C 里 n 分形连续），落盘仍按 16 列一块逐块 Fixpipe。
            // 用途：把「Mmad 的多 n 输出布局」和「Fixpipe 的多 n 一次落盘」两件事分开判——
            // 本支绿 ⇒ L0C 布局是 [n/16][16][16] 连续、失败点在多 n 的那一条 Fixpipe；
            // 本支红 ⇒ 失败点在 Mmad 的多 n 输出。
            MmadParams mp;
            mp.m = static_cast<uint16_t>(CUBE_M_TILE);
            mp.n = static_cast<uint16_t>(nSize);
            mp.k = static_cast<uint16_t>(kSize);
            mp.unitFlag = 0;
            mp.kDirectionAlign = false;
            mp.cmatrixSource = false;
            mp.cmatrixInitVal = true;
            Mmad(c1, a2, b2, mp);

            SetFlag<HardEvent::M_FIX>(static_cast<event_t>(EVENT_ID2));
            WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(EVENT_ID2));

            for (int32_t nj = 0; nj < nBlocks; ++nj) {
                GlobalTensor<float> gc;
                gc.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(cGm) + mi * CUBE_M_TILE * nSize +
                                   nj * PLUT132_FIXPIPE_TILE_N);
                FixpipeParamsV220 fp;
                fp.nSize = static_cast<uint16_t>(PLUT132_FIXPIPE_TILE_N);
                fp.mSize = static_cast<uint16_t>(CUBE_M_TILE);
                fp.srcStride = static_cast<uint16_t>(PLUT132_FIXPIPE_SRC_STRIDE);
                fp.dstStride = static_cast<uint32_t>(nSize);
                fp.reluEn = false;
                fp.ndNum = 1;
                Fixpipe(gc, c1[nj * CUBE_TILE_FLOATS], fp);
                ++fixCount;

                SetFlag<HardEvent::FIX_M>(static_cast<event_t>(EVENT_ID3));
                WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(EVENT_ID3));
            }
        } else if (nMode == 3 || nMode == 4 || nMode == 5) {
            // 0a：多 n 块一次落盘（FixpipeParamsV220 的 ndNum / srcNdStride / dstNdStride）。
            // 与 nMode=0 的唯一差别是「Fixpipe 条数」：Mmad 仍是每 16 列一条（已验证绿的形状），
            // 但 nBlocks 个 n 分形先各自驻留 L0C（nj*256 float），末尾一条 Fixpipe 落 ndNum 个 ND 矩阵：
            //   mSize = nSize = 16、dstStride = nSize（ND 行 pitch，与已验收的 dstStride=nPad 同一规则）、
            //   dstNdStride = 16（元素；第 nj 块在行内偏移 nj*16 ⇒ 行 r 第 nj 块落在 r*nSize + nj*16）。
            // srcNdStride：nMode=3 → 2，nMode=4 → 1（依据见上面两个常量的注释）。
            // 每条 Fixpipe 读自己那一段 L0C（mi 偏移）：实测 m 轴 >1 时若各 m 块共用同一段，
            // 第 mi 块的落盘拿到第 mi+1 块的值（可解码映射：C[i][j] = j*100+i，mTile1 的 16 行
            // 全是 mTile2 的值，mTile3 正确），故按 m 块分段，见 docs/results/plut132-aic-ndnum-probe.json。
            const int32_t ndTileFloats = nBlocks * CUBE_TILE_FLOATS;
            // 0a 追加 (2026-10-30)：nMode=5 把 mi 偏移去掉，每个 mi 复用同一段 8 KiB。
            // 唯一变量 = L0C 常驻占用（mTiles*8 KiB → 8 KiB），一个 API 参数都没改。
            const int32_t ndBase = (nMode == 5) ? 0 : (mi * ndTileFloats);
            for (int32_t nj = 0; nj < nBlocks; ++nj) {
                MmadParams mp;
                mp.m = static_cast<uint16_t>(CUBE_M_TILE);
                mp.n = static_cast<uint16_t>(PLUT132_FIXPIPE_TILE_N);
                mp.k = static_cast<uint16_t>(kSize);
                mp.unitFlag = 0;
                mp.kDirectionAlign = false;
                mp.cmatrixSource = false;
                mp.cmatrixInitVal = true;
                Mmad(c1[ndBase + nj * CUBE_TILE_FLOATS], a2, b2[nj * (kSize / 8) * CUBE_FRAC_FLOATS], mp);
            }
            SetFlag<HardEvent::M_FIX>(static_cast<event_t>(EVENT_ID2));
            WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(EVENT_ID2));

            GlobalTensor<float> gc;
            gc.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(cGm) + mi * CUBE_M_TILE * nSize);
            FixpipeParamsV220 fp;
            fp.nSize = static_cast<uint16_t>(PLUT132_FIXPIPE_TILE_N);
            fp.mSize = static_cast<uint16_t>(CUBE_M_TILE);
            fp.srcStride = static_cast<uint16_t>(PLUT132_FIXPIPE_SRC_STRIDE);
            fp.dstStride = static_cast<uint32_t>(nSize);
            fp.reluEn = false;
            fp.ndNum = static_cast<uint16_t>(nBlocks);
            fp.srcNdStride = static_cast<uint16_t>((nMode == 3) ? PLUT132_SRC_ND_STRIDE_512B
                                                               : PLUT132_SRC_ND_STRIDE_FRAC);
            fp.dstNdStride = static_cast<uint16_t>(PLUT132_FIXPIPE_TILE_N);
            Fixpipe(gc, c1[ndBase], fp);
            ++fixCount;

            SetFlag<HardEvent::FIX_M>(static_cast<event_t>(EVENT_ID3));
            WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(EVENT_ID3));
        } else {
            MmadParams mp;
            mp.m = static_cast<uint16_t>(CUBE_M_TILE);
            mp.n = static_cast<uint16_t>(nSize);
            mp.k = static_cast<uint16_t>(kSize);
            mp.unitFlag = 0;
            mp.kDirectionAlign = false;
            mp.cmatrixSource = false;
            mp.cmatrixInitVal = true;
            Mmad(c1, a2, b2, mp);

            SetFlag<HardEvent::M_FIX>(static_cast<event_t>(EVENT_ID2));
            WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(EVENT_ID2));

            if (mFix == 0) {
                // 一次 Fixpipe 落 ND [16][nSize]：dstStride = nSize（元素），srcStride = CeilAlign(m,16)
                GlobalTensor<float> gc;
                gc.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(cGm) + mi * CUBE_M_TILE * nSize);
                FixpipeParamsV220 fp;
                fp.nSize = static_cast<uint16_t>(nSize);
                fp.mSize = static_cast<uint16_t>(CUBE_M_TILE);
                fp.srcStride = static_cast<uint16_t>(PLUT132_FIXPIPE_SRC_STRIDE_N);
                fp.dstStride = static_cast<uint32_t>(nSize);
                fp.reluEn = false;
                fp.ndNum = 1;
                Fixpipe(gc, c1, fp);
                ++fixCount;

                SetFlag<HardEvent::FIX_M>(static_cast<event_t>(EVENT_ID3));
                WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(EVENT_ID3));
            }
        }

        // L0A 只在 m 轴复用：下一轮 LoadData 会覆写 L0A，必须先等本轮最后一次 Mmad 读完它
        // （M -> MTE1）。缺这一行的实测后果：rows=64/k=64 的 m1/m2 瓦片错 3.5~4.6；rows=64/k=64/n=32
        // 直接 aicore exception："L0A read/write conflict in the MTE (same address)"（507015）。
        SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(EVENT_ID4));
        WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(EVENT_ID4));
    }

    if (mFix != 0) {
        // 各 m 分形的 L0C 地址连续（mi*nSize），末尾一次 Fixpipe(mSize=rows) 落 [rows][nSize]
        GlobalTensor<float> gc;
        gc.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(cGm));
        FixpipeParamsV220 fp;
        fp.nSize = static_cast<uint16_t>(nSize);
        fp.mSize = static_cast<uint16_t>(rows);
        fp.srcStride = static_cast<uint16_t>(((rows + PLUT132_FIXPIPE_TILE_N - 1) / PLUT132_FIXPIPE_TILE_N) *
                                             PLUT132_FIXPIPE_TILE_N);
        fp.dstStride = static_cast<uint32_t>(nSize);
        fp.reluEn = false;
        fp.ndNum = 1;
        Fixpipe(gc, c1, fp);
        ++fixCount;

        SetFlag<HardEvent::FIX_MTE3>(static_cast<event_t>(EVENT_ID3));
        WaitFlag<HardEvent::FIX_MTE3>(static_cast<event_t>(EVENT_ID3));
    }

    // 落盘条数自证：写到 cGm[rows*nSize]（int32），门脚本核对「nMode=3/4 ⇒ 条数 = rows/16」
    GlobalTensor<int32_t> gcnt;
    gcnt.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(cGm) + rows * nSize);
    gcnt.SetValue(0, fixCount);
    DataCacheCleanAndInvalid<int32_t, CacheLine::SINGLE_CACHE_LINE, DcciDst::CACHELINE_OUT>(gcnt);
}

// ============================================================================
// PLUT-132 R2：AIC 服务体。三段 GEMM 全部 fp32（D1 路线 A），操作数一个 16 bit 都不进 Cube，
// 于是 alpha / gamma / beta 的舍入不会进 GEMM：
//   (1) P^T    = Bc[16][nPad] · Cpad[16][nPad]^T           k = N      （一次 16x16 落盘）
//   (2) out_r  = aState[rows][nPad] · Cpad^T + W[rows][16] · P^T   k = N + 16
//   (3) S_cube = W[rows][16] · bc_nk[nPad][16]              k = 16     （落自然布局 [rows][nPad]）
// ---- 2026-10-30 第三轮：A/B 两试的结论直接影响这一段，先记在这里 ----
//   A（Mmad 一次吃满 n + 一条 Fixpipe 落 n>16）与 B（一条 Fixpipe 落 mSize=rows）在 910B3 上都**红**，
//   实测见 docs/results/plut132-aic-fulln-probe.json；且失败点在 Mmad(n>16) 的 L0C 输出形态，
//   不在 srcStride（取 0 与取 CeilAlign(m,16)=16 都是错的、且错法不同）。因此 AIC 服务体保持
//   「n 按 16 切块、每块一条 Mmad + 一条 Fixpipe」这个**唯一实测绿**的形态：一条都不省。
//   落盘条数（rows=64, nPad=128 的 perf-8）：S_cube 32 + out_r_pre 4 = 36 条（与上一轮同口径），
//   加上 P^T 那一条，一 job 全量 37 条。
// 三次落盘都用 Fixpipe(ndNum=1, srcStride=0, dstStride=行 pitch, mSize=16)，S_cube 的 dstStride = nPad，
// AIV 侧不再按瓦片索引图重组（本轮探针 fx_nat_* 用 m=16 / m=64 各验过一遍）。
// 同步一律「置位即等」：本轮先闭合功能与代价口径，双缓冲留给下一轮的流水优化。
// ============================================================================
class CubeAic {
public:
    __aicore__ inline void Init(GM_ADDR scratchGm, GM_ADDR tiling)
    {
        scratch_ = scratchGm;
        t_ = (__gm__ Mamba3DecodeStepTiling *)tiling;
        rows_ = t_->chunkRows;
        n_ = t_->dState;
        nPad_ = Mamba3CubeNPad(n_);
        rank_ = t_->rank;
        sc_ = Mamba3CubeScratchOf(rows_, nPad_);
        pipe_.InitBuffer(bufA1_, MAMBA3_CUBE_KCH * MAMBA3_CUBE_KV * 4);
        pipe_.InitBuffer(bufB1_, nPad_ * MAMBA3_CUBE_KV * 4);
        pipe_.InitBuffer(bufA2_, MAMBA3_CUBE_KCH * MAMBA3_CUBE_KV * 4);
        pipe_.InitBuffer(bufB2_, nPad_ * MAMBA3_CUBE_KV * 4);
        pipe_.InitBuffer(bufC1_, ((rows_ / 16) + 1) * 256 * 4);
        a1_ = bufA1_.Get<float>();
        b1_ = bufB1_.Get<float>();
        a2_ = bufA2_.Get<float>();
        b2_ = bufB2_.Get<float>();
        c1_ = bufC1_.Get<float>();
    }

    __aicore__ inline void Process()
    {
        const int64_t grid = t_->grid;
        const int64_t step = t_->blockNum;  // 1 AIC : 1 AIV ⇒ 一个 AIC 只服务同号的 AIV
        // AIV 的一个 job 覆盖 tileD 行，但 AIC 一次 RunJob 只算 chunkRows 行（scratch 也只装一块）。
        // 所以每个 job index 必须跑 chunksPerTile 次 RunJob，与 AIV 的 chunk 循环一一对应。
        const int64_t chunks = (t_->chunksPerTile > 0) ? t_->chunksPerTile : 1;
        for (int64_t i = GetBlockIdx(); i < grid; i += step) {
            for (int64_t c = 0; c < chunks; ++c) {
                RunJob(i, 0);
            }
        }
    }

private:
    // 一块 16 行（nValue=16）的 A/B 操作数：GM --Nd2Nz--> L1 --LoadData--> L0A/L0B
    __aicore__ inline void LoadTile(__gm__ float *src, int32_t kLen, int32_t pitch, LocalTensor<float> l1,
                                    LocalTensor<float> l0)
    {
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = static_cast<uint16_t>(MAMBA3_CUBE_KV);
        p.dValue = static_cast<uint16_t>(kLen);
        p.srcNdMatrixStride = 0;
        p.srcDValue = static_cast<uint16_t>(pitch);
        p.dstNzC0Stride = static_cast<uint16_t>(MAMBA3_CUBE_KV);
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        GlobalTensor<float> g;
        g.SetGlobalBuffer(src);
        DataCopy(l1, g, p);
        SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(EVENT_ID0));
        WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(EVENT_ID0));
        LoadData2DParams lp;
        lp.startIndex = 0;
        lp.repeatTimes = static_cast<uint8_t>(kLen / 8);
        lp.srcStride = 1;
        lp.sid = 0;
        lp.dstGap = 0;
        lp.ifTranspose = false;
        lp.addrMode = 0;
        LoadData(l0, l1, lp);
        SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(EVENT_ID1));
        WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(EVENT_ID1));
        SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(EVENT_ID5));
        WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(EVENT_ID5));
    }

    // bc_nk 是 [nPad][16]（k 连续）：一次 Nd2Nz + 每 16 列一块 LoadData，全部 n 块驻留 L0B
    __aicore__ inline void LoadBcNk(__gm__ float *src, int32_t nBlocks)
    {
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = static_cast<uint16_t>(nPad_);
        p.dValue = static_cast<uint16_t>(MAMBA3_CUBE_KV);
        p.srcNdMatrixStride = 0;
        p.srcDValue = static_cast<uint16_t>(MAMBA3_CUBE_KV);
        p.dstNzC0Stride = static_cast<uint16_t>(nPad_);
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        GlobalTensor<float> g;
        g.SetGlobalBuffer(src);
        DataCopy(b1_, g, p);
        SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(EVENT_ID0));
        WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(EVENT_ID0));
        for (int32_t nj = 0; nj < nBlocks; ++nj) {
            LoadData2DParams lp;
            lp.startIndex = static_cast<uint16_t>(nj);
            lp.repeatTimes = static_cast<uint8_t>(MAMBA3_CUBE_KV / 8);
            lp.srcStride = static_cast<uint16_t>(nBlocks);
            lp.sid = 0;
            lp.dstGap = 0;
            lp.ifTranspose = false;
            lp.addrMode = 0;
            LoadData(b2_[nj * 256], b1_, lp);
        }
        SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(EVENT_ID1));
        WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(EVENT_ID1));
    }

    __aicore__ inline void MmadTile(LocalTensor<float> c, LocalTensor<float> a, LocalTensor<float> b, int32_t nSize,
                                    int32_t kSize, bool init)
    {
        MmadParams mp;
        mp.m = static_cast<uint16_t>(MAMBA3_CUBE_KV);
        mp.n = static_cast<uint16_t>(nSize);
        mp.k = static_cast<uint16_t>(kSize);
        mp.unitFlag = 0;
        mp.kDirectionAlign = false;
        mp.cmatrixSource = false;
        mp.cmatrixInitVal = init;
        Mmad(c, a, b, mp);
        SetFlag<HardEvent::M_FIX>(static_cast<event_t>(EVENT_ID2));
        WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(EVENT_ID2));
        SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(EVENT_ID4));
        WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(EVENT_ID4));
    }

    // srcStride = 0：nSize=16 时该字段不参与寻址（实测）。第三轮试过按 CANN 定义取
    // CeilAlign(mSize,16)=16 去一次落多 n 分形，仍然红（见 plut132-aic-fulln-probe.json），
    // 所以这里回到实测唯一绿的取值，不做「未验证的顺手改」。
    __aicore__ inline void FixTile(LocalTensor<float> c, __gm__ float *dst, int32_t nSize, int32_t dstStride)
    {
        FixpipeParamsV220 fp;
        fp.nSize = static_cast<uint16_t>(nSize);
        fp.mSize = static_cast<uint16_t>(MAMBA3_CUBE_KV);
        fp.srcStride = 0;
        fp.dstStride = static_cast<uint32_t>(dstStride);
        fp.reluEn = false;
        fp.ndNum = 1;
        GlobalTensor<float> g;
        g.SetGlobalBuffer(dst);
        Fixpipe(g, c, fp);
        SetFlag<HardEvent::FIX_M>(static_cast<event_t>(EVENT_ID3));
        WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(EVENT_ID3));
    }

    __aicore__ inline void RunJob(int64_t idx, int32_t sub)
    {
        const int32_t mTiles = static_cast<int32_t>(rows_ / 16);
        const int32_t nBlocks = static_cast<int32_t>(nPad_ / 16);
        const int32_t nChunks = static_cast<int32_t>((nPad_ + MAMBA3_CUBE_KCH - 1) / MAMBA3_CUBE_KCH);
        // 1 AIC : 1 AIV ⇒ 服务对象就是同号的那一个 AIV，scratch 段 = GetBlockIdx()（sub 恒 0）。
        __gm__ float *base = reinterpret_cast<__gm__ float *>(scratch_) +
                             static_cast<int64_t>(GetBlockIdx()) * sc_.total;

        // F1（V->C）：一次 RunJob = 该 AIV 的一个 chunk ⇒ 只等一次、单 id。
        // 上一版「每 job 等两次」在 chunks=1 时置位只有 1 次 ⇒ 尾部永远等不到（探针 6/6 超时即此形态）；
        // 在按 sub 分 id 的版本里则要求同 pair 第二个 AIV 也能投递，n12b 已证不能。
        CrossCoreWaitFlag<2, PIPE_MTE2>(MAMBA3_CC_F1_ID);
        SetHF32Mode(HF32Mode::DISABLE);
        (void)idx;
        (void)sub;  // 1 AIC : 1 AIV ⇒ sub 恒 0，段号由 GetBlockIdx() 唯一决定

        // ---- (1) P^T = (Cpad · Bc^T) = [r'][r] = P[r][r']^T，k = N（按 64 切）----
        // 方向必须是这个：第 (2) 步消费 pp 时按 B 操作数 [n][k] 读，n = r'、k = r，
        // 即内存里要的是 P[r][r'] 的**转置** [r'][r]。Mmad 的 A/B 互换正好给出转置
        // （C[m][n] = A_m·B_n^T），所以这里把 Cpad 放 A、Bc 放 B。
        // R=1 时 r=r'=0，两种摆位数字完全相同 —— 这正是此前只有 rank>=2 才红的原因。
        for (int32_t c = 0; c < nChunks; ++c) {
            const int32_t kOff = c * MAMBA3_CUBE_KCH;
            const int32_t kLen = (kOff + MAMBA3_CUBE_KCH <= static_cast<int32_t>(nPad_))
                                     ? MAMBA3_CUBE_KCH
                                     : (static_cast<int32_t>(nPad_) - kOff);
            LoadTile(base + sc_.cp + kOff, kLen, static_cast<int32_t>(nPad_), a1_, a2_);
            LoadTile(base + sc_.bk + kOff, kLen, static_cast<int32_t>(nPad_), b1_, b2_);
            MmadTile(c1_[mTiles * 256], a2_, b2_, 16, kLen, c == 0);
        }
        FixTile(c1_[mTiles * 256], base + sc_.pp, 16, 16);

        // ---- (2) out_r = aState · Cpad^T + W · P^T ----
        for (int32_t c = 0; c < nChunks; ++c) {
            const int32_t kOff = c * MAMBA3_CUBE_KCH;
            const int32_t kLen = (kOff + MAMBA3_CUBE_KCH <= static_cast<int32_t>(nPad_))
                                     ? MAMBA3_CUBE_KCH
                                     : (static_cast<int32_t>(nPad_) - kOff);
            LoadTile(base + sc_.cp + kOff, kLen, static_cast<int32_t>(nPad_), b1_, b2_);
            for (int32_t mi = 0; mi < mTiles; ++mi) {
                LoadTile(base + sc_.ac + static_cast<int64_t>(mi) * 16 * nPad_ + kOff, kLen,
                         static_cast<int32_t>(nPad_), a1_, a2_);
                MmadTile(c1_[mi * 256], a2_, b2_, 16, kLen, c == 0);
            }
        }
        // 追加 W · P^T（k = 16，P^T 在 GM 里是 16x16）
        LoadTile(base + sc_.pp, 16, 16, b1_, b2_);
        for (int32_t mi = 0; mi < mTiles; ++mi) {
            LoadTile(base + sc_.w + static_cast<int64_t>(mi) * 16 * 16, 16, 16, a1_, a2_);
            MmadTile(c1_[mi * 256], a2_, b2_, 16, 16, false);
        }
        for (int32_t mi = 0; mi < mTiles; ++mi) {
            FixTile(c1_[mi * 256], base + sc_.orr + static_cast<int64_t>(mi) * 16 * 16, 16, 16);
        }

        // ---- (3) S_cube = W · bc_nk，落自然布局 [rows][nPad]（覆盖 aState 那块）----
        LoadBcNk(base + sc_.bc, nBlocks);
        for (int32_t mi = 0; mi < mTiles; ++mi) {
            LoadTile(base + sc_.w + static_cast<int64_t>(mi) * 16 * 16, 16, 16, a1_, a2_);
            for (int32_t nj = 0; nj < nBlocks; ++nj) {
                MmadTile(c1_[0], a2_, b2_[nj * 256], 16, 16, true);
                FixTile(c1_[0], base + sc_.ac + static_cast<int64_t>(mi) * 16 * nPad_ + nj * 16, 16,
                        static_cast<int32_t>(nPad_));
            }
        }

        // F2（C->V）：本次 RunJob 服务的那个 AIV 等它，单 id、置一次。
        CrossCoreSetFlag<2, PIPE_FIX>(MAMBA3_CC_F2_ID);
    }

    GM_ADDR scratch_ = nullptr;
    __gm__ Mamba3DecodeStepTiling *t_ = nullptr;
    int64_t rows_ = 0;
    int64_t n_ = 0;
    int64_t nPad_ = 0;
    int64_t rank_ = 0;
    Mamba3CubeScratch sc_;
    TPipe pipe_;
    TBuf<TPosition::A1> bufA1_;
    TBuf<TPosition::B1> bufB1_;
    TBuf<TPosition::A2> bufA2_;
    TBuf<TPosition::B2> bufB2_;
    TBuf<TPosition::CO1> bufC1_;
    LocalTensor<float> a1_;
    LocalTensor<float> b1_;
    LocalTensor<float> a2_;
    LocalTensor<float> b2_;
    LocalTensor<float> c1_;
};

}  // namespace Mamba3DecodeStep

// 自测门：只由探针工程（operators/plut132_cube_fp32_probe）驱动，op 入口不使用它。
// 落盘是 tile-major：C 的瓦片 (mi, nj) 在 cGm + (mi*nBlocks + nj) * 256 个 float 处，行 pitch
// 恒为 PLUT132_FIXPIPE_LD = 16（元素），由 host 侧按索引图重组回 [rows][n]。
//
// kernel type 显式标注（不是噪声）：bisheng 的 __clang_cce_defines.h:52-60 给出三个标注
//   __cube__   = __attribute__((aic))                          —— 只跑 AIC
//   __vector__ = __attribute__((aiv))                          —— 只跑 AIV（v4 入口一直用这个）
//   __mix__(c, v) = __attribute__((core_ratio(c, v)))          —— MIX 核，AIC:AIV 比例
// 不标就落到「auto type derivate」，编译器警告 `kernel type ... is not marked`；AIC/AIV 分工
// 靠的就是这个推导，接 op dispatch 时最先失效的往往是它。本入口只跑 AIC ⇒ __cube__。
extern "C" __global__ __cube__ void mamba3_decode_step_cube_gate(
    GM_ADDR aGm, GM_ADDR bGm, GM_ADDR cGm, int32_t rows, int32_t kSize, int32_t nSize, int32_t bLayout, int32_t nMode,
    int32_t mFix)
{
    if ASCEND_IS_AIC {
        Mamba3DecodeStep::CubeTileBody(aGm, bGm, cGm, rows, kSize, nSize, bLayout, nMode, mFix);
    }
}

// ============================================================================
// PLUT-132 R2：Cube 通路入口（mix 核：1 个 AIC 服务同核两个 AIV 的 job）
// 与 v4 入口同一批入参，只在最后多一个 scratch（每 AIV 一段，host 侧按
// blockDim * total * 4 B 申请）。op 级 dispatch **已接**：见 mamba3_decode_step_torch.cpp 的
// CubePathEnabled() —— 环境变量 MAMBA3_DECODE_STEP_CUBE=1 才走这里，默认仍是 v4。
// ============================================================================
// 1 个 AIC 服务 1 个 AIV ⇒ __mix__(1, 1)（core_ratio），不标会落到 auto type derivate。
// 1:2 试过：同 pair 第二个 AIV 的 CrossCore 置位到不了 AIC（探针 n12b 70 s 超时），故收敛到 1:1。
extern "C" __global__ __mix__(1, 1) void mamba3_decode_step_cube(
    GM_ADDR state, GM_ADDR bstate, GM_ADDR xstate, GM_ADDR aGm, GM_ADDR bGm, GM_ADDR cGm, GM_ADDR dGm,
    GM_ADDR xGm, GM_ADDR dtGm, GM_ADDR trapGm, GM_ADDR xprojGm, GM_ADDR outprojGm, GM_ADDR zGm,
    GM_ADDR zprojGm, GM_ADDR stateOutGm, GM_ADDR outGm, GM_ADDR scratchGm, GM_ADDR tiling)
{
    if ASCEND_IS_AIV {
        AscendC::TPipe pipe;
        Mamba3DecodeStep::Kernel op(&pipe);
        op.Init(state, bstate, xstate, aGm, bGm, cGm, dGm, xGm, dtGm, trapGm, xprojGm, outprojGm, zGm, zprojGm,
                stateOutGm, outGm, tiling);
        op.SetCubeScratch(scratchGm);
        op.ProcessCube();
    }
    if ASCEND_IS_AIC {
        Mamba3DecodeStep::CubeAic aic;
        aic.Init(scratchGm, tiling);
        aic.Process();
    }
}