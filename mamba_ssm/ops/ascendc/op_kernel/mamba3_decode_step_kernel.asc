        const int64_t n = t_->dState;
        const int64_t rank = t_->rank;
        const int64_t rb = t_->rankBlock;
        const int64_t eszState = static_cast<int64_t>(ElemSize(static_cast<int32_t>(t_->dtypeState)));
        const int64_t eszBC = static_cast<int64_t>(ElemSize(static_cast<int32_t>(t_->dtypeBC)));
        const int64_t eszX = static_cast<int64_t>(ElemSize(static_cast<int32_t>(t_->dtypeX)));
        const int64_t eszProj = static_cast<int64_t>(ElemSize(static_cast<int32_t>(t_->dtypeProj)));

        pipe_->InitBuffer(bufRaw_, AlignBytes(rows * n * eszState));  // state 原始 dtype
        // state_out 单独 stage：不再与点积暂存 (prod) 复用同一块 UB
