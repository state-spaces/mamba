    // ------------------------------------------------------------------ 同步
    __aicore__ inline void SyncMte2ToVec()
    {
        SetFlag<HardEvent::MTE2_V>(static_cast<event_t>(EVENT_ID0));
        WaitFlag<HardEvent::MTE2_V>(static_cast<event_t>(EVENT_ID0));
    }
    __aicore__ inline void SyncVecToScalar()
    {
        SetFlag<HardEvent::V_S>(static_cast<event_t>(EVENT_ID1));
        WaitFlag<HardEvent::V_S>(static_cast<event_t>(EVENT_ID1));
    }
    __aicore__ inline void SyncVecToMte3()
    {
        SetFlag<HardEvent::V_MTE3>(static_cast<event_t>(EVENT_ID2));
        WaitFlag<HardEvent::V_MTE3>(static_cast<event_t>(EVENT_ID2));
    }
    __aicore__ inline void SyncMte3ToVec()
    {
        SetFlag<HardEvent::MTE3_V>(static_cast<event_t>(EVENT_ID3));
        WaitFlag<HardEvent::MTE3_V>(static_cast<event_t>(EVENT_ID3));
