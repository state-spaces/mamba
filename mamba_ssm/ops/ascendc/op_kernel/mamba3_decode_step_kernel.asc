constexpr int32_t DT_FP32 = MAMBA3_DT_FP32;
constexpr int32_t DT_FP16 = MAMBA3_DT_FP16;
constexpr int32_t DT_BF16 = MAMBA3_DT_BF16;
constexpr int32_t SLOT = MAMBA3_SLOT;                // 32B block 内的 fp32 元素数
constexpr int32_t REP_ELEMS = MAMBA3_VEC_REP_ELEMS;  // mask=64 时一次 repeat 覆盖的 fp32 元素

__aicore__ inline uint32_t ElemSize(int32_t dt)
{
    return (dt == DT_FP32) ? 4u : 2u;
}

__aicore__ inline int64_t AlignBytes(int64_t bytes)
{
    return ((bytes + 31) / 32) * 32;
}

// ============================================================================
// PLUT-132 R2：AIV 备料 + CrossCore + AIC 三段 GEMM 的公共定义
//
// 跨核消息编码（impl/basic_api/dav_c220/kernel_operator_sync_impl.h:118-124 原文）：
//   constexpr uint16_t SYNC_MODE_SHIFT_VALUE = 4;
//   constexpr uint16_t SYNC_FLAG_SHIFT_VALUE = 8;
//   return (0x1 + ((mode & 0x3) << SYNC_MODE_SHIFT_VALUE) + ((flagId & 0xf) << SYNC_FLAG_SHIFT_VALUE));
// 即 mode 只保留低 2 位、flagId 只保留低 4 位（⇒ flagId 必须 <= 15）。
// mode 不是可以随便填的装饰位 —— 两轮各错一次，症状都是 120 s 死等：
//   * 更早一轮把 matmul 的 INTRA_MODE 常量 4 直接当 mode 用，&0x3 后是 0（C->C）：AIC 置的 F2 发回了
//     Cube 自己，AIV 永远等不到；
//   * 第五轮之前 AIV 侧 F1 写的是 <1, PIPE_MTE3>（mode 1，照枚举名字猜的方向），该置位从未投递到 AIC。
// 实测唯一可投递的形态是**置位侧 mode = 2**（探针 n11b：AIV 置 mode 2、AIC 等一次 ⇒ PASS，
// aic_marker=900；证据 docs/results/plut132-cube-dispatch-selftest.json）。等待侧不看 mode
// （sync_impl.h:490-491 的 (void)modeId / wait_flag_dev(flagId)），方向由「置位核 + flagId」决定。
// ============================================================================
constexpr uint16_t MAMBA3_CC_F1_ID = 0;      // AIV -> AIC：本 chunk 的小矩阵已落 GM（置位侧 mode 必须是 2）
constexpr uint16_t MAMBA3_CC_F2_ID = 4;      // AIC -> AIV：S_cube / out_r 已落 GM（同上，mode 2）
// 同步协议（2026-10-30 第五轮实测定死，证据 docs/results/plut132-cube-dispatch-selftest.json
// 的 n11b / n12b 两条）：
//   一个 AIC 只服务**一个** AIV（入口 __mix__(1, 1)），F1 / F2 各用一个 id、一次置位对一次等待。
//   为什么不是 1 AIC : 2 AIV —— 两条都在探针里试过，都不成立：
//     * 两个 AIV 置同一个 id、AIC 等两次：6/6 挂 60 s（置位次数与等待次数不成对）；
//     * 两个 AIV 各置 f1Id+sub（0/1）、AIC 依次等 0 与 1：70 s 超时，且 info 里只有 sub=0 的写入
//       （aiv_slots=[100, 0]）—— 同 pair 第二个 AIV 的置位到不了 AIC。
//   而「单 AIV 置一次、AIC 等一次」（n11b）稳定通过（aic_marker=900）。所以按已证形态收敛。
constexpr int32_t MAMBA3_CUBE_KV = 16;   // 2R <= 8，pad 到 16
constexpr int32_t MAMBA3_CUBE_KCH = 64;  // M2 / P 的 k 轴分块（不超过已实测的 k <= 64 上限）

__aicore__ inline int64_t Mamba3CubeNPad(int64_t n)
{
    return ((n + 15) / 16) * 16;
}

// 每核 scratch 布局（全 fp32，单位 float）：AIC 只读这一块，不碰任何 16 bit 数据
struct Mamba3CubeScratch {
    int64_t w;    // W      [rows][16]   M1 / M2b 的 A 操作数
    int64_t bc;   // bc_nk  [nPad][16]   M1 的 B 操作数（Bc 转置）
    int64_t bk;   // Bc     [16][nPad]   P^T 的 A 操作数（k 行、n 连续）
    int64_t cp;   // Cpad   [16][nPad]   P^T / M2a 的 B 操作数（r 行、n 连续）
    int64_t ac;   // aState [rows][nPad] M2a 的 A；M2 跑完后再被 S_cube 覆盖
    int64_t pp;   // P^T    [16][16]
    int64_t orr;  // out_r  [rows][16]
    int64_t total;
};

__aicore__ inline Mamba3CubeScratch Mamba3CubeScratchOf(int64_t rows, int64_t nPad)
{
    Mamba3CubeScratch s;
    s.w = 0;
    s.bc = s.w + rows * MAMBA3_CUBE_KV;
    s.bk = s.bc + nPad * MAMBA3_CUBE_KV;
    s.cp = s.bk + MAMBA3_CUBE_KV * nPad;
    s.ac = s.cp + MAMBA3_CUBE_KV * nPad;
    s.pp = s.ac + rows * nPad;
    s.orr = s.pp + MAMBA3_CUBE_KV * MAMBA3_CUBE_KV;
    s.total = s.orr + rows * MAMBA3_CUBE_KV;
    return s;
}

class Kernel {
public:
    __aicore__ inline explicit Kernel(TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR state, GM_ADDR bstate, GM_ADDR xstate, GM_ADDR aGm, GM_ADDR bGm,
                                GM_ADDR cGm, GM_ADDR dGm, GM_ADDR xGm, GM_ADDR dtGm, GM_ADDR trapGm,
                                GM_ADDR xprojGm, GM_ADDR outprojGm, GM_ADDR zGm, GM_ADDR zprojGm,
                                GM_ADDR stateOutGm, GM_ADDR outGm, GM_ADDR tiling)
    {
