        pipe_->InitBuffer(bufOutF_, AlignBytes(rows * rank * 4));
        pipe_->InitBuffer(bufBcStage_, 3 * AlignBytes(rb * n * eszBC));
        pipe_->InitBuffer(bufProjStage_, 3 * AlignBytes(rb * rows * eszProj));
        pipe_->InitBuffer(bufVecStage_, 3 * AlignBytes(rows * eszX));
        pipe_->InitBuffer(bufScalarStage_, 128);

        pipe_->InitBuffer(bufS_, AlignBytes(rows * n * 4));     // 状态平面 fp32
        pipe_->InitBuffer(bufProd_, AlignBytes(rows * n * 4));  // 点积乘积 / w64 广播暂存
        pipe_->InitBuffer(bufBc_, 3 * AlignBytes(rb * n * 4));
        pipe_->InitBuffer(bufProj_, 3 * AlignBytes(rb * rows * 4));

        pipe_->InitBuffer(bufX_, AlignBytes(rows * 4));
        pipe_->InitBuffer(bufXs_, AlignBytes(rows * 4));
        pipe_->InitBuffer(bufZ_, AlignBytes(rows * 4));
        pipe_->InitBuffer(bufU_, AlignBytes(rows * 4));
