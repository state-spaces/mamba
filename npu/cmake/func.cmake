# func.cmake — 算子自注册宏：把算子源文件追加到全局列表
# include 目录记录为调用方算子目录下的绝对路径（多算子并存时顶层展开不歧义）
macro(register_direct_launch_op KERNEL_SRCS KERNEL_INCLUDE_DIR PLUGIN_SRCS PLUGIN_INCLUDE_DIR)
    set(ALL_KERNEL_SRCS ${ALL_KERNEL_SRCS} ${KERNEL_SRCS} PARENT_SCOPE)
    set(ALL_PLUGIN_SRCS ${ALL_PLUGIN_SRCS} ${PLUGIN_SRCS} PARENT_SCOPE)
    set(ALL_KERNEL_INCLUDE_DIRS ${ALL_KERNEL_INCLUDE_DIRS}
        ${CMAKE_CURRENT_SOURCE_DIR}/${KERNEL_INCLUDE_DIR} PARENT_SCOPE)
    set(ALL_PLUGIN_INCLUDE_DIRS ${ALL_PLUGIN_INCLUDE_DIRS}
        ${CMAKE_CURRENT_SOURCE_DIR}/${PLUGIN_INCLUDE_DIR} PARENT_SCOPE)
endmacro()
